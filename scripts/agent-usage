#!/usr/bin/env node
// Every coding agent's plan-quota rows in one block, each drawn by the
// renderer of the footer that already shows it:
// - CODEX: Pi's footer (codex-quota-extension quotaBuckets +
//   context-session-footer renderQuotaLines), from the usage state Pi saves.
// - CLAUDE: ~/.claude/quota-rows.js, from the usage answer Claude Code saves
//   in ~/.claude.json (also starts its background /usage refresh when stale).
// - GEMINI: ~/.claude/quota-rows.js, from the reading agy's status line
//   saves (~/.gemini/tmux-status/quota.json).
// - ROOM: two rows derived from all of the above; see roomRow.
//
// `agent-usage` prints the groups once, a blank line apart. `agent-usage
// --watch` prints one JSON array of groups (arrays of rows) per second until
// stdin closes; tmux-oil's footer lays them out.
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { createRequire } from "node:module";
import { pathToFileURL } from "node:url";

const home = os.homedir();
const PI = path.join(home, ".pi", "agent");
const QUOTA_ROWS = process.env.AGY_QUOTA_ROWS ?? path.join(home, ".claude", "quota-rows.js");

const { quotaBuckets, parseUsageState } = await import(
	pathToFileURL(path.join(PI, "extensions", "codex-quota-extension", "store.ts")).href
);
const { renderQuotaLines } = await import(
	pathToFileURL(path.join(PI, "extensions", "context-session-footer", "quota.ts")).href
);
const { renderQuotaRows, claudeQuotaRows, savedAgyQuotaRows } = createRequire(import.meta.url)(QUOTA_ROWS);

// Same escapes as quota-rows.js, so both renderers parse alike downstream.
const SGR = { dim: "\x1b[2m", ok: "\x1b[32m", warning: "\x1b[33m", error: "\x1b[31m" };
const RESET = "\x1b[0m";
const theme = { fg: (color, text) => (SGR[color] ? `${SGR[color]}${text}${RESET}` : text) };

const attempt = (read) => {
	try {
		return read();
	} catch {
		return [];
	}
};

// --- ROOM -------------------------------------------------------------------
// How fast each agent's plan can be spent, as a multiple of an even pace, and
// still last until its window resets: remaining fraction ÷ fraction of the
// window still to run. 1.00× is exactly even; 2.00× means twice an even rate
// lasts; 0.50× means slow to half. Arithmetic on the reported readings, not a
// usage forecast. Each agent shows its tightest window of the kind; FULL
// means no window of that kind has been touched or its reset has passed.
const WINDOW_MS = { "5H": 5 * 3_600_000, WEEK: 7 * 86_400_000 };
const AGENTS = ["CLAUDE", "GEMINI", "CODEX"];

// [{ agent, kind, remaining: 0..100, resetAt?: epoch ms }]
const roomRow = (kind, windows, now) => {
	const entries = AGENTS.map((agent) => {
		const mine = windows.filter((window) => window.agent === agent && window.kind === kind);
		if (mine.length === 0) return " ".repeat(agent.length + 6);
		const rooms = mine
			.filter((window) => window.resetAt > now)
			.map((window) => window.remaining / 100 / ((window.resetAt - now) / WINDOW_MS[kind]));
		const room = rooms.length ? Math.min(...rooms) : undefined;
		const text = room === undefined ? "FULL" : `${room.toFixed(room >= 10 ? 0 : 2)}×`;
		const color = room === undefined || room >= 1 ? "ok" : room >= 0.5 ? "warning" : "error";
		return `${theme.fg("dim", `${agent} `)}${theme.fg(color, text.padStart(5))}`;
	});
	return `${theme.fg("dim", `ROOM ${kind}`)}${entries.join("   ")}`;
};

const usageRows = (now) => {
	const windows = [];
	const codex = attempt(() => {
		const buckets = quotaBuckets(
			parseUsageState(JSON.parse(fs.readFileSync(path.join(PI, "codex-usage-state.json"), "utf8"))),
			now,
		);
		for (const bucket of buckets)
			windows.push({
				agent: "CODEX",
				kind: bucket.window,
				remaining: bucket.remaining,
				resetAt: bucket.increases[0] ? bucket.increases[0].at * 1000 : undefined,
			});
		return renderQuotaLines(buckets, Infinity, theme, now, (text) => text.length, (text) => text);
	});
	const others = attempt(() => [...claudeQuotaRows(undefined, now), ...savedAgyQuotaRows()]);
	for (const row of others)
		windows.push({
			agent: row.label.split(" ")[0],
			kind: row.label.endsWith(" 5H") ? "5H" : "WEEK",
			remaining: 100 - row.used,
			resetAt: row.resetAt,
		});
	const room = windows.length ? ["WEEK", "5H"].map((kind) => roomRow(kind, windows, now)) : [];
	return [...codex, ...attempt(() => renderQuotaRows(others, now)), ...room];
};

const LABEL = /^\x1b\[2m(.*?) *\x1b\[0m/;
// Rows grouped by quota (CODEX, CLAUDE, GEMINI, ROOM: the label's first
// word), every label padded to one width so bars line up across groups too.
const usageGroups = (now = Date.now()) => {
	const groups = [];
	for (const row of usageRows(now)) {
		const key = row.match(LABEL)?.[1].split(" ")[0];
		if (groups.at(-1)?.key !== key) groups.push({ key, rows: [] });
		groups.at(-1).rows.push(row);
	}
	const width = Math.max(0, ...groups.flatMap(({ rows }) => rows.map((row) => row.match(LABEL)?.[1].length ?? 0)));
	return groups.map(({ rows }) =>
		rows.map((row) => row.replace(LABEL, (_, label) => `${SGR.dim}${label.padEnd(width)} ${RESET}`)),
	);
};

if (process.argv[2] === "--watch") {
	// Ends with its reader: stdin closing, a broken stdout, or being orphaned.
	process.stdin.on("end", () => process.exit(0)).resume();
	process.stdout.on("error", () => process.exit(0));
	const tick = () => {
		if (process.ppid === 1) process.exit(0);
		process.stdout.write(`${JSON.stringify(usageGroups())}\n`);
		setTimeout(tick, 1000 - (Date.now() % 1000));
	};
	tick();
} else {
	const groups = usageGroups();
	if (groups.length) process.stdout.write(`${groups.map((rows) => rows.join("\n")).join("\n\n")}\n`);
}
