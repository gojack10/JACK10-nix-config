#!/usr/bin/env bash
# home-manager switch helper. Resolves the flake in the same places the
# zsh jack10_flake function does, then delegates to `home-manager switch`.
# Checked into the repo (not generated) so it can be used during bootstrap,
# before a first home-manager generation exists.
set -euo pipefail

resolve_flake() {
  local -a candidates=()
  [[ -n "${JACK10_NIX_CONFIG_FLAKE:-}" ]] && candidates+=("$JACK10_NIX_CONFIG_FLAKE")
  candidates+=(
    "$HOME/.config/JACK10-nix-config"
    "$HOME/.config/home-manager"
    "$HOME/projects/JACK10-nix-config"
  )

  local c
  for c in "${candidates[@]}"; do
    [[ -n "$c" && -f "$c/flake.nix" ]] && { printf '%s\n' "$c"; return 0; }
  done

  echo "hms: could not find JACK10-nix-config. Set JACK10_NIX_CONFIG_FLAKE to the flake path." >&2
  return 1
}

list_hosts() {
  local flake="$1"
  nix eval "$flake#homeConfigurations" --apply 'x: builtins.attrNames x' 2>/dev/null \
    | tr -d '[]"' | tr ' ' '\n' | grep -v '^$'
}

main() {
  local flake hosts host
  flake=$(resolve_flake)
  hosts=$(list_hosts "$flake")

  host="${1:-}"
  if [[ -z "$host" ]]; then
    echo "Usage: hms <hostname>"
    echo "Available hosts:"
    echo "$hosts" | sed 's/^/  /'
    return 1
  fi

  if ! echo "$hosts" | grep -qx "$host"; then
    echo "Unknown host: $host" >&2
    echo "Available:" >&2
    echo "$hosts" | sed 's/^/  /' >&2
    return 1
  fi

  # Always update flake inputs and rebuild before switching
  nix flake update "$flake" &>/dev/null || true
  local result="/tmp/hms-activation-$host"
  nix build "$flake#homeConfigurations.$host.activationPackage" -o "$result"

  # Home Manager restarts an agent whenever its plist changes. A proxy-only
  # restart loses the in-memory native ticket map while DS4 keeps its gate and
  # receipts, leaving every Qwen request blocked with HTTP 500. Stop before
  # activation rather than killing a live conversation or bypassing that guard.
  if [[ "$host" == m5-max ]] &&
     ! cmp -s "$result/LaunchAgents/com.local.llm.proxy.plist" \
              "$HOME/Library/LaunchAgents/com.local.llm.proxy.plist" &&
     launchctl print "gui/$(id -u)/com.dsv4.server" 2>/dev/null |
       grep -Eq '^[[:space:]]*pid = [0-9]+'; then
    echo "hms: proxy LaunchAgent changed while DS4 is running; refusing an unsafe proxy-only restart." >&2
    echo "hms: coordinate stopping the proxy and DS4, activating, then starting DS4 with a fresh gate; a proxy-only retry will still fail." >&2
    return 1
  fi

  if command -v home-manager >/dev/null 2>&1; then
    exec "$result/activate"
  else
    # First-run path: no home-manager on PATH yet. Use `nix run` so bootstrap
    # works before any generation has been built.
    exec nix run home-manager/master -- switch --flake "$flake#$host"
  fi
}

main "$@"
