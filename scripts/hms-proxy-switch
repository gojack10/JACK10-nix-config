#!/usr/bin/env bash
# Installation uses the same maintenance switch as ordinary operator work.
set -euo pipefail
result=${1:?activation package required}
switch="$HOME/.pi/agent/local-ai"
"$switch" stop
activation_rc=0
"$result/activate" || activation_rc=$?
# Activation may start reception, but its maintenance marker prevents requests
# from loading an engine until the installation has finished.
"$switch" start
if (( activation_rc != 0 )); then
  echo "hms: activation failed ($activation_rc); panel is waiting with engines off" >&2
  exit "$activation_rc"
fi
