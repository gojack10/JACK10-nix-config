#!/usr/bin/env bash
set -euo pipefail

REPO="${1:-$HOME/.local/share/pi-mono}"
RUNTIME_BRANCH="${PI_RUNTIME_BRANCH:-coding-agent/local-runtime-patches}"

if [[ ! -d "$REPO/.git" ]]; then
  echo "pi-mono not found at $REPO" >&2
  exit 1
fi

cd "$REPO"
if ! git show-ref --verify --quiet "refs/heads/$RUNTIME_BRANCH"; then
  echo "Missing authoritative runtime branch: $RUNTIME_BRANCH" >&2
  exit 1
fi

latest="$(git tag -l 'v*' --sort=-version:refname | head -1)"
if [[ -z "$latest" ]]; then
  echo "No release tags found." >&2
  exit 1
fi

status=0
if git merge-base --is-ancestor "$latest" "$RUNTIME_BRANCH"; then
  echo "✅ $RUNTIME_BRANCH contains $latest"
else
  echo "❌ $RUNTIME_BRANCH must be reconciled with $latest"
  status=1
fi

if [[ "$(git rev-parse HEAD)" == "$(git rev-parse "$RUNTIME_BRANCH")" ]]; then
  echo "✅ active checkout matches $RUNTIME_BRANCH"
else
  echo "❌ active checkout is not $RUNTIME_BRANCH"
  status=1
fi

exit "$status"
