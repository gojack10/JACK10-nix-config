#!/usr/bin/env bash
# shellcheck disable=SC2016
set -euo pipefail

REPO="$HOME/.local/share/pi-mono"
BASELINE="$REPO/.audit-baseline.txt"
PATCHES_DIR="$HOME/.pi/agent/patches"
RUNTIME_BRANCH="${PI_RUNTIME_BRANCH:-coding-agent/local-runtime-patches}"
CANDIDATE_ROOT="${PI_UPDATE_CANDIDATE_ROOT:-$HOME/.local/state/pi-update/candidates}"
NODE_BIN="${PI_NODE:-node}"
NPM_BIN="npm"
if command -v mise >/dev/null 2>&1; then
  NODE_BIN="mise exec node@24 -- node"
  NPM_BIN="mise exec node@24 -- npm"
elif [[ -x "$HOME/.local/bin/mise" ]]; then
  NODE_BIN="$HOME/.local/bin/mise exec node@24 -- node"
  NPM_BIN="$HOME/.local/bin/mise exec node@24 -- npm"
fi

load_jack10_ssh_env() {
  local helper
  for helper in \
    "${JACK10_SSH_ENV_HELPER:-}" \
    "$HOME/.local/share/JACK10-nix-config/ssh-env.sh" \
    "$HOME/.config/JACK10-nix-config/scripts/lib/ssh-env.sh"; do
    if [[ -n "$helper" && -r "$helper" ]]; then
      # shellcheck disable=SC1090
      . "$helper"
      jack10_load_ssh_env
      return 0
    fi
  done
}

load_jack10_ssh_env

if [[ ! -d "$REPO/.git" ]]; then
  echo "pi-mono not found at $REPO" >&2
  exit 1
fi

cd "$REPO"

# ── Helpers ──────────────────────────────────────────────────────────

write_pi_launcher() {
  local launcher="$HOME/.local/bin/pi"
  mkdir -p "$(dirname "$launcher")"
  cat > "$launcher" <<'EOF'
#!/usr/bin/env bash
# pi — launcher using compiled JS from the local checkout.
REPO="${PI_REPO:-$HOME/.local/share/pi-mono}"
CLI="$REPO/packages/coding-agent/dist/cli.js"
RUNTIME_BRANCH="${PI_RUNTIME_BRANCH:-coding-agent/local-runtime-patches}"
export PI_PACKAGE_DIR="$REPO/packages/coding-agent"
if [[ -z "${PI_ALLOW_UNRECONCILED:-}" ]] && git -C "$REPO" show-ref --verify --quiet "refs/heads/$RUNTIME_BRANCH"; then
  active="$(git -C "$REPO" rev-parse HEAD)"
  expected="$(git -C "$REPO" rev-parse "$RUNTIME_BRANCH")"
  if [[ "$active" != "$expected" ]]; then
    echo "Pi runtime is not the reconciled $RUNTIME_BRANCH branch." >&2
    echo "Run pi-update after reconciling the candidate, or set PI_ALLOW_UNRECONCILED=1 for recovery." >&2
    exit 1
  fi
fi
# Make SiftText available when Pi is launched outside an interactive shell.
if [[ -z "${SIFTTEXT_API_KEY:-}" && -f "$HOME/.config/pi-secrets/env" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.config/pi-secrets/env"
fi
NODE_BIN="${PI_NODE:-node}"
if command -v mise >/dev/null 2>&1; then
	NODE_BIN="mise exec node@24 -- node"
elif [[ -x "$HOME/.local/bin/mise" ]]; then
	NODE_BIN="$HOME/.local/bin/mise exec node@24 -- node"
fi

exec $NODE_BIN "$CLI" "$@"
EOF
  chmod +x "$launcher"
}

needs_rebuild() {
  local cli="$REPO/packages/coding-agent/dist/cli.js"

  [[ ! -d "$REPO/node_modules" ]] && return 0
  [[ ! -f "$REPO/node_modules/undici/package.json" ]] && return 0
  [[ ! -f "$cli" ]] && return 0
  [[ -n "$(find "$REPO/packages" -path '*/src/*' -type f -newer "$cli" -print -quit)" ]] && return 0
  return 1
}

install_and_build() {
  echo "Installing locked deps (--ignore-scripts blocks third-party install hooks)..."
  $NPM_BIN ci --ignore-scripts --silent

  echo "Building workspace packages..."
  $NPM_BIN run build --silent
}

update_pi_packages() {
  local pi_bin="$HOME/.local/bin/pi"
  if [[ ! -x "$pi_bin" ]]; then
    echo "pi launcher not found at $pi_bin" >&2
    return 1
  fi

  echo "Updating pi packages..."
  "$pi_bin" update --extensions --no-approve
}

ghsa_ids_from_audit() {
  { $NPM_BIN audit --json 2>/dev/null || true; } | $NODE_BIN -e '
    let input = ""; process.stdin.on("data", c => input += c);
    process.stdin.on("end", () => {
      let d; try { d = JSON.parse(input); } catch { process.exit(0); }
      const ids = new Set();
      for (const v of Object.values(d.vulnerabilities || {})) {
        for (const via of v.via || []) {
          if (typeof via === "object" && via.url) {
            const m = via.url.match(/GHSA-[a-z0-9-]+/);
            if (m) ids.add(m[0]);
          }
        }
      }
      console.log([...ids].sort().join("\n"));
    });
  '
}

describe_ghsas() {
  local wanted_csv="$1"
  { $NPM_BIN audit --json 2>/dev/null || true; } | $NODE_BIN -e '
    let input = ""; process.stdin.on("data", c => input += c);
    process.stdin.on("end", () => {
      let d; try { d = JSON.parse(input); } catch { process.exit(0); }
      const wanted = new Set((process.argv[1] || "").split(",").filter(Boolean));
      const seen = new Set();
      for (const [pkg, v] of Object.entries(d.vulnerabilities || {})) {
        for (const via of v.via || []) {
          if (typeof via !== "object" || !via.url) continue;
          const m = via.url.match(/GHSA-[a-z0-9-]+/);
          if (!m || !wanted.has(m[0]) || seen.has(m[0])) continue;
          seen.add(m[0]);
          console.log(`  [${via.severity}] ${pkg}: ${via.title}`);
          console.log(`    ${via.url}`);
        }
      }
    });
  ' "$wanted_csv"
}

# ── Sync pi-agent (patches, extensions, config) ─────────────────────

prompt_pi_agent_git_url() {
  if [[ -n "${PI_AGENT_GIT_URL:-}" ]]; then
    printf '%s\n' "$PI_AGENT_GIT_URL"
    return 0
  fi
  if [[ -n "${JACK10_PI_AGENT_GIT_URL:-}" ]]; then
    printf '%s\n' "$JACK10_PI_AGENT_GIT_URL"
    return 0
  fi

  local target target_port target_path
  target="${PI_AGENT_SSH_TARGET:-${JACK10_PI_AGENT_TARGET:-${JACK10_SSH_TARGET:-}}}"
  target_port="${PI_AGENT_SSH_PORT:-${JACK10_PI_AGENT_PORT:-${JACK10_SSH_PORT:-}}}"
  target_path="${PI_AGENT_REPO_PATH:-${JACK10_PI_AGENT_REPO_PATH:-git/pi-agent.git}}"
  if [[ -n "$target" ]]; then
    jack10_git_ssh_url "$target" "$target_port" "$target_path"
    return 0
  fi

  local default_user default_port default_path user host port path
  default_user="$(whoami)"
  default_port="${JACK10_PI_AGENT_PORT:-${JACK10_SSH_PORT:-22}}"
  default_path="${JACK10_PI_AGENT_REPO_PATH:-git/pi-agent.git}"

  read -rp "pi-agent SSH user [$default_user]: " user
  user="${user:-$default_user}"

  read -rp "pi-agent SSH host: " host
  if [[ -z "$host" ]]; then
    echo "pi-agent SSH host is required." >&2
    return 1
  fi

  read -rp "pi-agent SSH port [$default_port]: " port
  port="${port:-$default_port}"

  read -rp "pi-agent repo path on host [$default_path]: " path
  path="${path:-$default_path}"

  if [[ "$path" = /* ]]; then
    printf 'ssh://%s@%s:%s%s\n' "$user" "$host" "$port" "$path"
  else
    printf 'ssh://%s@%s:%s/%s\n' "$user" "$host" "$port" "$path"
  fi
}

sync_pi_agent() {
  local agent_dir="$HOME/.pi/agent"

  if [[ -d "$agent_dir/.git" ]]; then
    echo "Pulling pi-agent from git..."
    if ! git -C "$agent_dir" pull --rebase --quiet; then
      echo "Error: failed to pull pi-agent repository. Check network or resolve conflicts." >&2
      return 1
    fi
  else
    local git_url
    git_url="$(prompt_pi_agent_git_url)"
    echo "Cloning pi-agent from $git_url ..."
    if [[ -e "$agent_dir" ]]; then
      local backup
      backup="$HOME/.local/state/pi-update/backups/pi-agent-$(date +%Y%m%d-%H%M%S)"
      mkdir -p "$(dirname "$backup")"
      cp -a "$agent_dir" "$backup"
      rm -rf "$agent_dir"
    fi
    mkdir -p "$(dirname "$agent_dir")"
    if ! git clone --quiet "$git_url" "$agent_dir"; then
      echo "Error: failed to clone pi-agent repository from $git_url" >&2
      return 1
    fi
  fi
}

# ── Transactional runtime reconciliation ────────────────────────────

assert_patch_branch() {
  local target="$1"
  local legacy_patches=("$PATCHES_DIR"/*.patch)
  if [[ -f "${legacy_patches[0]}" ]]; then
    echo "Legacy .patch files still exist in $PATCHES_DIR." >&2
    echo "Port, discard, or refactor them onto $RUNTIME_BRANCH, then remove the duplicate artifacts." >&2
    return 1
  fi
  if ! git show-ref --verify --quiet "refs/heads/$RUNTIME_BRANCH"; then
    echo "Missing authoritative runtime branch: $RUNTIME_BRANCH" >&2
    return 1
  fi
  if ! git merge-base --is-ancestor "$target" "$RUNTIME_BRANCH"; then
    return 2
  fi
}

check_active_runtime() {
  local target="$1"
  local status
  if assert_patch_branch "$target"; then
    :
  else
    status=$?
    if [[ $status -eq 2 ]]; then
      echo "$RUNTIME_BRANCH has not been reconciled with $(git log -1 --format='%h %s' "$target")." >&2
    fi
    return "$status"
  fi
  local active expected
  active="$(git rev-parse HEAD)"
  expected="$(git rev-parse "$RUNTIME_BRANCH")"
  if [[ "$active" != "$expected" ]]; then
    echo "Active checkout is not $RUNTIME_BRANCH." >&2
    return 1
  fi
  echo "Runtime reconciled: $RUNTIME_BRANCH contains $(git log -1 --format='%h %s' "$target")"
}

run_candidate_checks() {
  local candidate_dir="$1"
  (
    cd "$candidate_dir"
    echo "Installing candidate dependencies..."
    $NPM_BIN ci --ignore-scripts --silent
    echo "Checking candidate..."
    $NPM_BIN run check --silent
    echo "Testing candidate..."
    $NPM_BIN --workspace packages/ai test --silent
    $NPM_BIN --workspace packages/coding-agent test --silent
    echo "Building candidate..."
    $NPM_BIN run build --silent
    PI_PACKAGE_DIR="$candidate_dir/packages/coding-agent" \
      $NODE_BIN "$candidate_dir/packages/coding-agent/dist/cli.js" --no-extensions --version
  )
}

promote_candidate() {
  local candidate_dir="$1"
  local target="$2"
  local current_head candidate_head candidate_branch stamp backup_branch rebase_merge rebase_apply
  if [[ ! -d "$candidate_dir" ]]; then
    echo "Candidate worktree not found: $candidate_dir" >&2
    return 1
  fi
  if ! git -C "$candidate_dir" merge-base --is-ancestor "$target" HEAD; then
    echo "Candidate does not contain the requested upstream target." >&2
    return 1
  fi
  rebase_merge="$(git -C "$candidate_dir" rev-parse --git-path rebase-merge)"
  rebase_apply="$(git -C "$candidate_dir" rev-parse --git-path rebase-apply)"
  if [[ -d "$rebase_merge" || -d "$rebase_apply" ]]; then
    echo "Candidate still has an unresolved rebase: $candidate_dir" >&2
    return 1
  fi
  if ! run_candidate_checks "$candidate_dir"; then
    echo "Update blocked: candidate checks failed; active Pi remains unchanged." >&2
    echo "Candidate retained at: $candidate_dir" >&2
    return 1
  fi

  current_head="$(git rev-parse "$RUNTIME_BRANCH")"
  candidate_head="$(git -C "$candidate_dir" rev-parse HEAD)"
  candidate_branch="$(git -C "$candidate_dir" branch --show-current)"
  stamp="$(date +%Y%m%d-%H%M%S)"
  backup_branch="backup/pi-runtime-$stamp"
  git worktree remove --force "$candidate_dir"
  git branch "$backup_branch" "$current_head"
  if [[ "$(git branch --show-current)" == "$RUNTIME_BRANCH" ]]; then
    git reset --hard "$candidate_head"
  else
    git switch -C "$RUNTIME_BRANCH" "$candidate_head"
  fi
  git branch -D "$candidate_branch" >/dev/null
  PROMOTED_FROM="$current_head"
  echo "Candidate promoted. Previous runtime: $backup_branch"
}

reconcile_candidate() {
  local target="$1"
  local target_label="$2"
  local base stamp candidate_branch candidate_dir
  base="$(git merge-base "$target" "$RUNTIME_BRANCH")"
  stamp="$(date +%Y%m%d-%H%M%S)"
  candidate_branch="pi-update/candidate-$stamp"
  candidate_dir="$CANDIDATE_ROOT/${target_label//\//-}-$stamp"

  mkdir -p "$CANDIDATE_ROOT"
  git worktree add --quiet -b "$candidate_branch" "$candidate_dir" "$RUNTIME_BRANCH"
  echo "Reconciling $RUNTIME_BRANCH against $target_label in $candidate_dir..."
  if ! git -C "$candidate_dir" -c core.hooksPath=/dev/null rebase --onto "$target" "$base"; then
    echo >&2
    echo "Update blocked: runtime commits need manual porting." >&2
    echo "Candidate retained at: $candidate_dir" >&2
    echo "Resolve every commit there, then run: pi-update --candidate=$candidate_dir" >&2
    return 1
  fi
  promote_candidate "$candidate_dir" "$target"
}

# ── Main ─────────────────────────────────────────────────────────────

YES=false
REPAIR=false
TRACK_MAIN=false
CHECK_ONLY=false
SKIP_AGENT_SYNC=false
CANDIDATE_DIR=""
PROMOTED_FROM=""
for arg in "$@"; do
  case "$arg" in
    -y|--yes) YES=true ;;
    --repair) REPAIR=true ;;
    --main) TRACK_MAIN=true ;;
    --check) CHECK_ONLY=true ;;
    --skip-agent-sync) SKIP_AGENT_SYNC=true ;;
    --candidate=*) CANDIDATE_DIR="${arg#*=}" ;;
    -h|--help)
      cat <<'EOF'
Usage: pi-update [--yes] [--repair] [--main] [--check] [--skip-agent-sync] [--candidate=PATH]

Updates Pi transactionally through coding-agent/local-runtime-patches. New
upstream releases are first rebased, checked, tested, and built in an isolated
candidate worktree; the working runtime is promoted only after success.

  --yes     Do not prompt for upgrade/audit baseline confirmation
  --repair  Reinstall dependencies and rebuild even if already current
  --main    Reconcile against current upstream main instead of the latest tag
  --check   Verify runtime reconciliation without changing the checkout
  --skip-agent-sync  Continue when the pi-agent remote is unavailable
  --candidate=PATH  Verify and promote a manually resolved candidate worktree
EOF
      exit 0
      ;;
    *)
      echo "Unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

SOURCE_REMOTE="origin"
if git remote get-url upstream >/dev/null 2>&1; then
  SOURCE_REMOTE="upstream"
fi

if $TRACK_MAIN; then
  echo "Fetching main from $SOURCE_REMOTE..."
  git fetch --quiet "$SOURCE_REMOTE" main
  CURRENT="$(git rev-parse HEAD)"
  LATEST="$SOURCE_REMOTE/main"
  TARGET="$(git rev-parse "$LATEST")"
  CURRENT_LABEL="$(git log -1 --format='%h %s' "$CURRENT")"
  LATEST_LABEL="$(git log -1 --format='%h %s' "$TARGET")"
else
  echo "Fetching tags from $SOURCE_REMOTE..."
  git fetch --tags --quiet "$SOURCE_REMOTE"
  CURRENT="$(git describe --tags --exact-match 2>/dev/null || echo '<detached>')"
  LATEST="$(git tag -l 'v*' --sort=-version:refname | head -1)"
  TARGET="$LATEST"
  CURRENT_LABEL="$CURRENT"
  LATEST_LABEL="$LATEST"

  if [[ -z "$LATEST" ]]; then
    echo "No version tags found." >&2
    exit 1
  fi
fi

if $CHECK_ONLY; then
  check_active_runtime "$TARGET"
  exit $?
fi

# Sync pi-agent before reconciliation so removed/superseded compatibility
# artifacts cannot silently survive into a new runtime.
if ! $SKIP_AGENT_SYNC; then
  sync_pi_agent
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Refusing to update a dirty Pi source checkout." >&2
  git status --short >&2
  exit 1
fi

if [[ -n "$CANDIDATE_DIR" ]]; then
  promote_candidate "$CANDIDATE_DIR" "$TARGET"
  REPAIR=true
fi

if assert_patch_branch "$TARGET"; then
  expected="$(git rev-parse "$RUNTIME_BRANCH")"
  if [[ "$(git rev-parse HEAD)" == "$expected" ]]; then
    echo "Already reconciled with $LATEST_LABEL: $RUNTIME_BRANCH"
  else
    echo "Activating reconciled runtime branch $RUNTIME_BRANCH..."
    git switch "$RUNTIME_BRANCH"
    REPAIR=true
  fi
else
  status=$?
  if [[ $status -ne 2 ]]; then
    exit "$status"
  fi

  echo "Current: $CURRENT_LABEL"
  echo "Latest:  $LATEST_LABEL"
  echo "The runtime branch requires reconciliation; the active runtime will remain untouched until checks pass."
  if ! $YES; then
    read -rp "Prepare and verify an isolated $LATEST_LABEL candidate? [y/N] " reply
    if [[ ! "$reply" =~ ^[yY]$ ]]; then
      echo "Aborted; current runtime unchanged."
      exit 1
    fi
  fi

  PROMOTED_FROM="$(git rev-parse "$RUNTIME_BRANCH")"
  reconcile_candidate "$TARGET" "$LATEST_LABEL"
  REPAIR=true
fi

write_pi_launcher

if $REPAIR || needs_rebuild; then
  if ! install_and_build; then
    if [[ -n "$PROMOTED_FROM" ]]; then
      echo "Activation build failed; restoring previous runtime $PROMOTED_FROM..." >&2
      git reset --hard "$PROMOTED_FROM"
      install_and_build || true
    fi
    exit 1
  fi
  echo
  echo "pi install/build complete. Pi is reconciled with $LATEST_LABEL"
else
  echo "Dependencies/build look present. Use --repair to force npm ci + build."
fi

echo
update_pi_packages

echo
echo "Checking npm audit against reviewed baseline..."

CURRENT_GHSAS="$(ghsa_ids_from_audit)"

if [[ ! -f "$BASELINE" ]]; then
  echo "No baseline file found — writing current state as initial baseline."
  printf '%s\n' "$CURRENT_GHSAS" > "$BASELINE"
  echo "Baseline: $BASELINE"
  exit 0
fi

NEW_GHSAS="$(comm -23 <(printf '%s\n' "$CURRENT_GHSAS") <(sort "$BASELINE") | sed '/^$/d')"

if [[ -z "$NEW_GHSAS" ]]; then
  echo "No new GHSA advisories."
  printf '%s\n' "$CURRENT_GHSAS" > "$BASELINE"
  exit 0
fi

echo "New GHSA advisories detected:"
printf '%s\n' "$NEW_GHSAS"
echo
describe_ghsas "$(printf '%s\n' "$NEW_GHSAS" | paste -sd, -)"
echo

if ! $YES; then
  read -rp "Mark these advisories as reviewed and update baseline? [y/N] " reply
  if [[ ! "$reply" =~ ^[yY]$ ]]; then
    echo "Leaving baseline unchanged: $BASELINE"
    exit 1
  fi
fi

printf '%s\n' "$CURRENT_GHSAS" > "$BASELINE"
echo "Baseline updated: $BASELINE"
