#!/usr/bin/env bash
# Behavioral check: stop before activation, reopen reception without inference.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/home/.pi/agent" "$tmp/generation"
export HOME="$tmp/home" TRACE="$tmp/trace"
cat > "$HOME/.pi/agent/local-ai" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$1" >> "$TRACE"
[[ "$1" != stop || ${FAIL_STOP:-0} == 0 ]]
STUB
cat > "$tmp/generation/activate" <<'STUB'
#!/usr/bin/env bash
printf 'activate\n' >> "$TRACE"
exit "${FAIL_ACTIVATION:-0}"
STUB
chmod +x "$HOME/.pi/agent/local-ai" "$tmp/generation/activate"

bash "$here/hms-proxy-switch" "$tmp/generation"
[[ $(< "$TRACE") == $'stop\nactivate\nstart' ]]
: > "$TRACE"
if FAIL_STOP=1 bash "$here/hms-proxy-switch" "$tmp/generation"; then
  echo 'activation ignored a failed maintenance stop' >&2; exit 1
fi
[[ $(< "$TRACE") == stop ]]
: > "$TRACE"
rc=0
FAIL_ACTIVATION=7 bash "$here/hms-proxy-switch" "$tmp/generation" || rc=$?
[[ "$rc" == 7 && $(< "$TRACE") == $'stop\nactivate\nstart' ]]
printf 'PASS: maintenance ordering, stop failure, activation failure; no model startup\n'
