#!/bin/sh
set -eu

if [ -z "${PATCHED_TMUX_BIN-}" ]; then
  PATCHED_TMUX_BIN=$(nix eval --raw \
    "$PWD#homeConfigurations.m5-max.config.programs.tmux.package")/bin/tmux
fi
export PATCHED_TMUX_BIN
PATH=$(dirname "$PATCHED_TMUX_BIN"):$PATH
export PATH

run_apply_case() {
  scenario=$1
  TMUX_BIN=$(command -v tmux)
  socket="tmux-oil-seg2-${scenario}-$$-$(date +%s)"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tmux-oil-test.XXXXXX")
  socket_path=
  cleanup_apply() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ -n "$attach_pid" ]; then
      kill "$attach_pid" 2>/dev/null || true
      wait "$attach_pid" 2>/dev/null || true
      attach_pid=
    fi
    if ! "$TMUX_BIN" -L "$socket" -f /dev/null kill-server >/dev/null 2>&1; then
      status=1
    fi
    rm -rf "$tmp"
    [ -n "$socket_path" ] && rm -f "$socket_path"
    if [ -n "$socket_path" ] && [ ! -e "$socket_path" ]; then
      printf 'cleanup_socket_removed=yes path=%s\n' "$socket_path"
    else
      printf 'cleanup_socket_removed=no path=%s\n' "${socket_path:-unknown}" >&2
      status=1
    fi
    exit "$status"
  }
  trap cleanup_apply EXIT
  trap 'exit 1' HUP INT TERM

  printf 'throwaway_socket=%s scenario=%s\n' "$socket" "$scenario"
  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s alpha 'sleep 120'
  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s beta 'sleep 120'
  if [ "$scenario" = cycle ] || [ "$scenario" = tree-delete ]; then
    "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s gamma 'sleep 120'
  fi
  if [ "$scenario" = tree-delete ]; then
    "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s delta 'sleep 120'
    alpha_id=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p -t alpha '#{session_id}')
    "$TMUX_BIN" -L "$socket" -f /dev/null set-option -t beta \
      @pi_subagent_parent_id "$alpha_id"
    "$TMUX_BIN" -L "$socket" -f /dev/null set-option -t gamma \
      @pi_subagent_parent_id "$alpha_id"
    # Leave a root between the parent and its children in server order. The
    # display tree flattens this, which used to make a planned child kill look
    # like external order drift after the parent was removed.
    "$TMUX_BIN" -L "$socket" -f /dev/null move-session -b -s delta -t beta
  fi
  socket_path=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p '#{socket_path}')
  server_pid=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p '#{pid}')
  attach_pid=
  if [ "$scenario" = self-delete ] || [ "$scenario" = tree-delete ]; then
    client_capture="$tmp/client-capture"
    attach_target=beta
    [ "$scenario" = tree-delete ] && attach_target=delta
    set +e
    env -u TMUX -u TMUX_PANE TERM=xterm-256color script -q "$client_capture" \
      "$TMUX_BIN" -L "$socket" -f /dev/null attach-session -t "$attach_target" >/dev/null 2>&1 &
    attach_pid=$!
    set -e
    clients=
    attempts=0
    while [ "$attempts" -lt 100 ]; do
      clients=$("$TMUX_BIN" -L "$socket" -f /dev/null list-clients -F '#{session_name}' 2>/dev/null | head -n 1)
      [ "$clients" = "$attach_target" ] && break
      attempts=$((attempts + 1))
      sleep .05
    done
    if [ "$clients" != "$attach_target" ]; then
      printf '%s: attached client did not reach %s\n' "$scenario" "$attach_target" >&2
      return 1
    fi
  fi

  cat >"$tmp/apply.lua" <<'LUA'
local M = assert(_G.tmux_oil)
local scenario = assert(vim.env.TMUX_OIL_TEST_SCENARIO)
local control_socket = assert(vim.env.TMUX_OIL_TEST_SOCKET)
local tmux_bin = assert(vim.env.TMUX_OIL_TMUX_BIN)

local function check(value, message)
  if not value then error(message, 0) end
end

local function control(args)
  local argv = { tmux_bin, "-L", control_socket, "-f", "/dev/null" }
  vim.list_extend(argv, args)
  local result = vim.system(argv, { text = true }):wait()
  check(result.code == 0, (result.stderr or "throwaway tmux command failed"):gsub("%s+$", ""))
  return result.stdout or ""
end

local function id_named(state, name)
  for id, value in pairs(state.by_id) do
    if value == name then return id end
  end
  error("missing session named " .. name, 0)
end

local function manifest(baseline, renames, deleted, creates)
  local lines = {}
  for _, id in ipairs(baseline.order) do
    if not deleted[id] then
      lines[#lines + 1] = id .. "\t" .. vim.json.encode(renames[id] or baseline.by_id[id])
    end
  end
  for _, name in ipairs(creates or {}) do
    lines[#lines + 1] = "+\t" .. vim.json.encode(name)
  end
  return table.concat(lines, "\n")
end

local function listing(label, state)
  io.stdout:write(label .. "_ID_LISTING:\n")
  local rendered = M.render(state)
  io.stdout:write((rendered == "" and "(empty)" or rendered) .. "\n")
end

local function intent_listing(text)
  io.stdout:write("INTENT_ID_LISTING:\n" .. (text == "" and "(empty)" or text) .. "\n")
end

local function report_argv(report)
  if not report or not report.attempted or #report.attempted == 0 then
    io.stdout:write("executor_argv=(none)\n")
    return
  end
  for _, argv in ipairs(report.attempted) do
    local status = report.failed and vim.deep_equal(argv, report.failed) and "failed" or "succeeded"
    io.stdout:write("executor_argv=" .. vim.json.encode(argv) .. " status=" .. status .. "\n")
  end
  for _, argv in ipairs(report.not_run) do
    io.stdout:write("executor_argv=" .. vim.json.encode(argv) .. " status=never-ran\n")
  end
end

local baseline = M.snapshot()
listing("BEFORE", baseline)
local alpha = id_named(baseline, "alpha")
local beta = id_named(baseline, "beta")

if scenario == "stable" then
  local text = manifest(baseline, { [alpha] = "alpha-renamed" }, {}, {})
  intent_listing(text)
  local report = M.apply(baseline, M.parse_manifest(text, baseline))
  local after = M.snapshot()
  listing("AFTER", after)
  report_argv(report)
  check(after.by_id[alpha] == "alpha-renamed", "rename did not retain the stable session ID")
  check(after.by_id[beta] == "beta", "rename changed the wrong stable session ID")
elseif scenario == "create-kill" then
  local text = manifest(baseline, { [beta] = "alpha" }, { [alpha] = true },
    { "gamma-created" })
  intent_listing(text)
  local report = M.apply(baseline, M.parse_manifest(text, baseline))
  local after = M.snapshot()
  listing("AFTER", after)
  report_argv(report)
  check(vim.tbl_count(after.by_id) == 2, "create+kill final session count is wrong")
  check(after.by_id[beta] == "alpha" and after.by_id[alpha] == nil,
    "create+kill changed or retained the wrong stable ID")
  check(id_named(after, "gamma-created") ~= nil, "created session is missing")
elseif scenario == "cycle" then
  local gamma = id_named(baseline, "gamma")
  local text = manifest(baseline, {
    [alpha] = "beta", [beta] = "gamma", [gamma] = "alpha",
  }, {}, {})
  intent_listing(text)
  local report = M.apply(baseline, M.parse_manifest(text, baseline))
  local after = M.snapshot()
  listing("AFTER", after)
  report_argv(report)
  check(after.by_id[alpha] == "beta" and after.by_id[beta] == "gamma"
    and after.by_id[gamma] == "alpha", "rename cycle final state is wrong")
  local temporary = 0
  for _, operation in ipairs(report.operations) do
    if operation.temporary then temporary = temporary + 1 end
  end
  check(temporary == 1, "rename cycle did not use exactly one temporary name")
elseif scenario == "drift" then
  local text = M.render(baseline)
  intent_listing(text)
  control({ "rename-session", "-t", alpha, "--", "external-drift" })
  local immediately_before = M.snapshot()
  listing("IMMEDIATELY_BEFORE_APPLY", immediately_before)
  local ok, err = pcall(M.apply, baseline, M.parse_manifest(text, baseline))
  check(not ok and tostring(err):find("structural drift detected", 1, true),
    "drift immediately before apply was not rejected")
  local after = M.snapshot()
  listing("AFTER", after)
  report_argv(M.last_apply_report)
  check(vim.deep_equal(immediately_before, after), "drift rejection executed a mutation")
elseif scenario == "mid-failure" then
  local text = manifest(baseline, {
    [alpha] = "alpha-renamed", [beta] = "beta-renamed",
  }, {}, { "never-created" })
  intent_listing(text)
  M.test_before_command = function(index, operation)
    if index == 2 then control({ "kill-session", "-t", operation.id }) end
  end
  local ok, err = pcall(M.apply, baseline, M.parse_manifest(text, baseline))
  M.test_before_command = nil
  check(not ok and tostring(err):find("tmux error at operation 2", 1, true),
    "forced mid-apply tmux error was not reported")
  check(tostring(err):find("no rollback was attempted", 1, true),
    "mid-apply error made an incorrect rollback claim")
  local report = assert(M.last_apply_report)
  local after = M.snapshot()
  listing("AFTER", after)
  report_argv(report)
  check(#report.succeeded == 1 and report.failed ~= nil and #report.not_run == 1,
    "partial apply report did not distinguish success, failure, and never-ran commands")
  check(after.by_id[alpha] == "alpha-renamed" and after.by_id[beta] == nil,
    "mid-apply failure did not preserve the exact partial state")
elseif scenario == "safety" then
  io.stdout:write("safety_policy=the last surviving session kill is rejected before mutation\n")
  local current = M.current_session_id()
  local other = current == alpha and beta or alpha
  control({ "kill-session", "-t", other })
  local last_baseline = M.snapshot()
  listing("LAST_SESSION_BEFORE", last_baseline)
  intent_listing("")
  local ok_last, last_err = pcall(M.apply, last_baseline, M.parse_manifest("", last_baseline))
  check(not ok_last and tostring(last_err):find("last session/server", 1, true),
    "last-session kill was not safely rejected")
  local after = M.snapshot()
  listing("AFTER", after)
  check(vim.deep_equal(last_baseline, after), "last-session rejection mutated state")
  report_argv(M.last_apply_report)
elseif scenario == "self-delete" then
  io.stdout:write("self_delete_policy=the invoking client moves to a surviving session before the kill\n")
  local current = M.current_session_id()
  check(current == beta, "did not resolve the attached client's session as current")
  local text = manifest(baseline, {}, { [beta] = true }, {})
  intent_listing(text)
  local observed = nil
  M.test_before_command = function(index, operation)
    if operation.kind == "kill" and operation.id == beta then
      observed = control({ "list-clients", "-F", "#{session_name}" }):gsub("%s+$", "")
    end
  end
  local ok, err = pcall(M.apply, baseline, M.parse_manifest(text, baseline))
  M.test_before_command = nil
  check(ok, "self-delete apply failed: " .. tostring(err))
  check(observed == "alpha", "the invoking client did not move to alpha before the kill")
  local after = M.snapshot()
  listing("AFTER", after)
  report_argv(M.last_apply_report)
  check(after.by_id[beta] == nil and after.by_id[alpha] == "alpha",
    "self-delete did not land in the exact surviving state")
  check(M.last_apply_report and #M.last_apply_report.succeeded == 1,
    "self-delete report did not record exactly one succeeded command")
  check(control({ "list-clients", "-F", "#{session_name}" }):gsub("%s+$", "") == "alpha",
    "the invoking client did not stay on the surviving session")
elseif scenario == "tree-delete" then
  io.stdout:write("tree_delete_policy=drift checks use raw server order, not flattened tree display order\n")
  local text = manifest(baseline, {}, {
    [id_named(baseline, "alpha")] = true,
    [id_named(baseline, "beta")] = true,
    [id_named(baseline, "gamma")] = true,
  }, {})
  intent_listing(text)
  local ok, err = pcall(M.apply, baseline, M.parse_manifest(text, baseline))
  check(ok, "interleaved parent-tree deletion failed: " .. tostring(err))
  local after = M.snapshot()
  listing("AFTER", after)
  report_argv(M.last_apply_report)
  check(after.by_id[id_named(baseline, "delta")] == "delta"
    and after.by_id[id_named(baseline, "alpha")] == nil
    and after.by_id[id_named(baseline, "beta")] == nil
    and after.by_id[id_named(baseline, "gamma")] == nil,
    "interleaved parent-tree deletion left the wrong sessions")
  check(M.last_apply_report and #M.last_apply_report.succeeded == 3
    and #M.last_apply_report.not_run == 0,
    "interleaved parent-tree deletion did not run every planned kill")
else
  error("unknown apply scenario " .. scenario, 0)
end
io.stdout:flush()
LUA

  TMUX="$socket_path,$server_pid,0" \
  TMUX_OIL_TEST_LUA="$tmp/apply.lua" \
  TMUX_OIL_TEST_SOCKET="$socket" \
  TMUX_OIL_TEST_SCENARIO="$scenario" \
  ./scripts/tmux-oil
}

run_reconcile_case() {
  scenario=$1
  TMUX_BIN=$(command -v tmux)
  socket="tmux-oil-reconcile-${scenario}-$$-$(date +%s)"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tmux-oil-reconcile.XXXXXX")
  socket_path=
  attach_pid=
  cleanup_reconcile() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ -n "$attach_pid" ]; then
      kill "$attach_pid" 2>/dev/null || true
      wait "$attach_pid" 2>/dev/null || true
    fi
    "$TMUX_BIN" -L "$socket" -f /dev/null kill-server >/dev/null 2>&1 || true
    [ -n "$socket_path" ] && rm -f "$socket_path"
    rm -rf "$tmp"
    exit "$status"
  }
  trap cleanup_reconcile EXIT
  trap 'exit 1' HUP INT TERM

  printf 'throwaway_socket=%s scenario=%s\n' "$socket" "$scenario"
  case "$scenario" in
    adjacent-new|refresh-adjacent-new|trace-a|compatible-rename|equal-rename|trace-c|\
      external-delete-edited|local-delete-live-renamed|already-deleted-local|\
      repeated-failure|conflict-recovery)
      "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s alpha 'sleep 120'
      "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s beta 'sleep 120'
      ;;
    trace-b|compatible-parent)
      "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s alpha 'sleep 120'
      "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s beta 'sleep 120'
      "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s gamma 'sleep 120'
      alpha_id=$($TMUX_BIN -L "$socket" -f /dev/null display-message -p -t alpha '#{session_id}')
      "$TMUX_BIN" -L "$socket" -f /dev/null set-option -t beta \
        @pi_subagent_parent_id "$alpha_id"
      ;;
    partial-create-recovery)
      for name in alpha beta gamma delta; do
        "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s "$name" 'sleep 120'
      done
      ;;
    partial-recovery)
      for name in alpha beta gamma delta epsilon zeta eta theta iota kappa lambda; do
        "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s "$name" 'sleep 120'
      done
      ;;
    parent-tree-raw-reorder|parent-tree-refresh|dirty-name-parent-tree-refresh)
      for name in alpha beta gamma delta; do
        "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s "$name" 'sleep 120'
      done
      alpha_id=$($TMUX_BIN -L "$socket" -f /dev/null display-message -p -t alpha '#{session_id}')
      "$TMUX_BIN" -L "$socket" -f /dev/null set-option -t beta \
        @pi_subagent_parent_id "$alpha_id"
      "$TMUX_BIN" -L "$socket" -f /dev/null set-option -t gamma \
        @pi_subagent_parent_id "$alpha_id"
      ;;
    parent-change-local-reorder|pending-reorder-refresh|pristine-refresh|live-order|\
      local-order-addition|equal-order|local-order-deleted|divergent-order)
      "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s alpha 'sleep 120'
      "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s beta 'sleep 120'
      "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s gamma 'sleep 120'
      ;;
    *) printf 'unknown reconcile scenario: %s\n' "$scenario" >&2; exit 2 ;;
  esac
  if [ "$scenario" = compatible-parent ]; then
    "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s other 'sleep 120'
  fi

  socket_path=$($TMUX_BIN -L "$socket" -f /dev/null display-message -p '#{socket_path}')
  server_pid=$($TMUX_BIN -L "$socket" -f /dev/null display-message -p '#{pid}')
  if [ "$scenario" = trace-b ] || [ "$scenario" = partial-recovery ]; then
    env -u TMUX -u TMUX_PANE TERM=xterm-256color script -q "$tmp/client-capture" \
      "$TMUX_BIN" -L "$socket" -f /dev/null attach-session -t alpha >/dev/null 2>&1 &
    attach_pid=$!
    attempts=0
    while [ "$attempts" -lt 100 ]; do
      clients=$($TMUX_BIN -L "$socket" -f /dev/null list-clients -F '#{session_name}' 2>/dev/null | head -n 1)
      [ "$clients" = alpha ] && break
      attempts=$((attempts + 1))
      sleep .05
    done
    [ "$clients" = alpha ] || { printf '%s attach failed\n' "$scenario" >&2; exit 1; }
  fi
  cat >"$tmp/reconcile.lua" <<'LUA'
local M = assert(_G.tmux_oil)
local scenario = assert(vim.env.TMUX_OIL_TEST_SCENARIO)
local control_socket = assert(vim.env.TMUX_OIL_TEST_SOCKET)
local tmux_bin = assert(vim.env.TMUX_OIL_TMUX_BIN)
local failures = {}

local function expect(value, message)
  if not value then failures[#failures + 1] = message end
end
local function control(args)
  local argv = { tmux_bin, "-L", control_socket, "-f", "/dev/null" }
  vim.list_extend(argv, args)
  local result = vim.system(argv, { text = true }):wait()
  expect(result.code == 0, (result.stderr or "control command failed"):gsub("%s+$", ""))
  return result.stdout or ""
end
local function id_named(state, name)
  for id, value in pairs(state.by_id) do
    if value == name then return id end
  end
  error("missing session " .. name, 0)
end
local function lines()
  return vim.api.nvim_buf_get_lines(M.buf, 0, -1, false)
end
local function row_for(id, values)
  for row, line in ipairs(values or lines()) do
    if line:sub(1, #id + 1) == id .. "\t" then return row end
  end
end
local function replace_name(id, name)
  local values = lines()
  local row = row_for(id, values)
  expect(row ~= nil, "buffer lost row for " .. id)
  if row then
    values[row] = id .. "\t" .. vim.json.encode(name)
    vim.api.nvim_buf_set_lines(M.buf, 0, -1, false, values)
  end
end
local function delete_row(id)
  local values = lines()
  local row = row_for(id, values)
  expect(row ~= nil, "buffer did not contain row for local deletion " .. id)
  if row then
    table.remove(values, row)
    vim.api.nvim_buf_set_lines(M.buf, 0, -1, false, values)
  end
end
local function reorder(ids)
  local values, result = lines(), {}
  for _, id in ipairs(ids) do
    local row = row_for(id, values)
    expect(row ~= nil, "buffer did not contain row for reorder " .. id)
    if row then result[#result + 1] = values[row] end
  end
  if #result == #ids then vim.api.nvim_buf_set_lines(M.buf, 0, -1, false, result) end
end
local function has_row(id, name)
  local row = row_for(id)
  return row ~= nil and lines()[row] == id .. "\t" .. vim.json.encode(name)
end
local function ids_in_buffer()
  local result = {}
  for _, line in ipairs(lines()) do
    result[#result + 1] = line:match("^(%$%d+)\t") or line
  end
  return result
end
local function names_in_order(state)
  local result = {}
  for _, id in ipairs(state.order) do result[#result + 1] = state.by_id[id] end
  return result
end
local function expect_names(state, wanted, label)
  expect(vim.deep_equal(names_in_order(state), wanted),
    label .. ": got " .. table.concat(names_in_order(state), ","))
end
local function save()
  local ok, result = M.save()
  return ok, result, M.last_apply_report or {}
end
local function first_line(value)
  return tostring(value):match("^[^\n]+") or tostring(value)
end
local function has_text(value, needle)
  return tostring(value):find(needle, 1, true) ~= nil
end
local function log_text()
  local paths = vim.fn.glob(vim.env.TMUX_OIL_ERROR_DIR .. "/*.log", false, true)
  if #paths == 0 then return "" end
  return table.concat(vim.fn.readfile(paths[#paths]), "\n")
end
local function no_operations(report, label)
  expect(report.operations and #report.operations == 0, label .. " planned operations")
  expect(not report.attempted or #report.attempted == 0, label .. " attempted a command")
  expect(not report.succeeded or #report.succeeded == 0, label .. " succeeded a command")
end

M.start()
local baseline = M.baseline
local alpha = id_named(baseline, "alpha")
local beta = id_named(baseline, "beta")
local gamma
for id, name in pairs(baseline.by_id) do
  if name == "gamma" then gamma = id; break end
end
local before_lines = lines()

if scenario == "adjacent-new" then
  vim.api.nvim_buf_set_lines(M.buf, -1, -1, false, {
    '+\t"new-one"', '+\t"new-two"',
  })
  local ok, result = save()
  expect(ok, "adjacent local new rows were rejected: " .. first_line(result))
  if ok then expect_names(M.snapshot(), { "alpha", "beta", "new-one", "new-two" },
    "adjacent local new rows") end
elseif scenario == "refresh-adjacent-new" then
  vim.api.nvim_buf_set_lines(M.buf, -1, -1, false, {
    '+\t"new-one"', '+\t"new-two"',
  })
  local ok, result = M.refresh()
  local refreshed = lines()
  expect(ok, "refresh rejected adjacent local new rows: " .. first_line(result))
  expect(vim.bo[M.buf].modified and refreshed[#refreshed - 1] == '+\t"new-one"'
    and refreshed[#refreshed] == '+\t"new-two"',
    "refresh did not retain adjacent new rows")
elseif scenario == "parent-tree-raw-reorder" then
  control({ "move-session", "-b", "-s", id_named(baseline, "delta"), "-t", beta })
  local live = M.snapshot()
  local raw = vim.deepcopy(live.server_order)
  local ok, result = save()
  expect(ok, "unchanged tree save rejected raw live reorder: " .. first_line(result))
  if ok then
    expect(vim.deep_equal(M.snapshot().server_order, raw),
      "unchanged tree save overwrote the concurrent raw order")
  end
elseif scenario == "parent-tree-refresh" then
  control({ "move-session", "-b", "-s", id_named(baseline, "delta"), "-t", beta })
  local raw = M.snapshot().server_order
  local ok, result = M.refresh()
  expect(ok, "pristine parent-tree refresh failed: " .. first_line(result))
  expect(vim.deep_equal(ids_in_buffer(), baseline.order) and not vim.bo[M.buf].modified,
    "pristine parent-tree refresh changed display rows or dirty state")
  expect(vim.deep_equal(M.snapshot().server_order, raw),
    "pristine parent-tree refresh changed raw server order")
elseif scenario == "dirty-name-parent-tree-refresh" then
  replace_name(alpha, "Mine")
  control({ "move-session", "-b", "-s", id_named(baseline, "delta"), "-t", beta })
  local raw = M.snapshot().server_order
  local ok, result = M.refresh()
  expect(ok, "dirty-name parent-tree refresh failed: " .. first_line(result))
  expect(vim.deep_equal(ids_in_buffer(), baseline.order) and has_row(alpha, "Mine")
    and vim.bo[M.buf].modified,
    "dirty-name parent-tree refresh lost display or local name intent")
  expect(vim.deep_equal(M.snapshot().server_order, raw),
    "dirty-name parent-tree refresh changed raw server order")
elseif scenario == "pending-reorder-refresh" then
  reorder({ beta, alpha, gamma })
  local ok, result = M.refresh()
  expect(ok, "pending reorder refresh failed: " .. first_line(result))
  expect(vim.deep_equal(ids_in_buffer(), { beta, alpha, gamma }) and vim.bo[M.buf].modified,
    "pending reorder refresh flattened away the user display intent")
  local save_ok, save_result = save()
  expect(save_ok, "pending reorder did not round-trip after refresh: " .. first_line(save_result))
  if save_ok then
    expect(vim.deep_equal(M.snapshot().server_order, { beta, alpha, gamma }),
      "pending reorder round-trip lost raw order")
  end
elseif scenario == "pristine-refresh" then
  local before = lines()
  local ok, result = M.refresh()
  expect(ok, "pristine refresh failed: " .. first_line(result))
  expect(vim.deep_equal(lines(), before) and not vim.bo[M.buf].modified,
    "pristine refresh changed a clean buffer")
elseif scenario == "parent-change-local-reorder" then
  local gamma_id = id_named(baseline, "gamma")
  control({ "set-option", "-t", beta, "@pi_subagent_parent_id", gamma_id })
  reorder({ beta, alpha, gamma_id })
  local ok, result = save()
  expect(ok, "parent change plus local reorder conflicted: " .. first_line(result))
  if ok then
    local after = M.snapshot()
    expect(after.parent_option_by_id[beta] == gamma_id,
      "parent change was not preserved")
    expect(vim.deep_equal(after.server_order, { beta, alpha, gamma_id }),
      "local reorder did not produce the intended raw order")
  end
elseif scenario == "partial-create-recovery" then
  local values = {}
  for index = #baseline.order, 1, -1 do
    values[#values + 1] = lines()[index]
  end
  values[#values + 1] = '+\t"created-once"'
  vim.api.nvim_buf_set_lines(M.buf, 0, -1, false, values)
  local injected = false
  M.test_before_command = function(index, operation)
    if index == 2 and not injected then
      injected = true
      control({ "rename-session", "-t", operation.id, "--", "external" })
    end
  end
  local first_ok, first_result, first_report = save()
  M.test_before_command = nil
  expect(not first_ok and injected, "partial create setup did not fail after a create")
  local created_id = first_report.created_ids and first_report.created_ids["created-once"]
  expect(created_id ~= nil, "partial create did not acknowledge the created stable ID")
  local second_ok, second_result, second_report = save()
  expect(second_ok, "partial create recovery failed: " .. first_line(second_result))
  if second_ok then
    expect(M.snapshot().by_id[created_id] == "created-once",
      "partial create recovery did not reuse the acknowledged stable ID")
  end
  for _, argv in ipairs(second_report.attempted or {}) do
    expect(argv[4] ~= "new-session", "partial create recovery repeated the create")
  end
elseif scenario == "partial-recovery" then
  local delete_alpha, delete_beta = id_named(baseline, "alpha"), id_named(baseline, "beta")
  delete_row(delete_alpha)
  delete_row(delete_beta)
  local wanted = {}
  for _, name in ipairs({ "lambda", "kappa", "iota", "theta", "eta", "zeta", "epsilon", "delta", "gamma" }) do
    wanted[#wanted + 1] = id_named(baseline, name)
  end
  reorder(wanted)
  local dirty_lines = lines()
  local notifications, notify = {}, vim.notify
  vim.notify = function(message) notifications[#notifications + 1] = tostring(message) end
  local injected = false
  M.test_before_command = function(index, operation)
    if index == 8 and not injected then
      injected = true
      control({ "rename-session", "-t", operation.id, "--", "external" })
    end
  end
  local write_ok, write_error = pcall(vim.cmd, "write")
  M.test_before_command = nil
  vim.notify = notify
  local first_report = assert(M.last_apply_report)
  expect(write_ok, "BufWriteCmd rethrew partial save: " .. tostring(write_error))
  expect(injected, "partial recovery did not inject before operation 8")
  expect(#first_report.succeeded >= 8 and #first_report.not_run > 0,
    "partial recovery did not record completed and pending operations")
  expect(M.ui_active and M.timer ~= nil, "partial save left polling stopped")
  expect(vim.bo[M.buf].modified, "partial save cleared the dirty buffer")
  expect(vim.deep_equal(lines(), dirty_lines), "partial save replaced the dirty buffer")
  expect(#notifications == 1, "partial save emitted more than one notification")
  local message = notifications[1] or ""
  expect(has_text(message, "completed") and has_text(message, "pending")
    and has_text(message, "Diagnostic saved to:"),
    "partial save notification was not concise/countable")
  expect(not has_text(message, "succeeded argv:"), "partial save notification leaked full report")
  expect(has_text(log_text(), "succeeded argv:") and has_text(log_text(), "never-ran argv:"),
    "partial save diagnostic omitted command evidence")

  local second_ok, second_error = pcall(vim.cmd, "write")
  local second_report = M.last_apply_report or {}
  expect(second_ok, "recovery BufWriteCmd failed: " .. tostring(second_error))
  for _, argv in ipairs(second_report.attempted or {}) do
    expect(argv[4] ~= "kill-session" and argv[4] ~= "new-session",
      "recovery repeated a completed destructive operation")
  end
elseif scenario == "trace-a" then
  replace_name(alpha, "AA")
  control({ "new-session", "-d", "-s", "c", "sleep 120" })
  local c_id = control({ "display-message", "-p", "-t", "c", "#{session_id}" }):gsub("%s+$", "")
  local ok, result = save()
  expect(ok, "Trace A compatible addition was rejected: " .. first_line(result))
  if ok then
    local after = M.snapshot()
    expect_names(after, { "AA", "beta", "c" }, "Trace A final names")
    expect(after.by_id[alpha] == "AA", "Trace A changed the wrong stable ID")
    expect(after.by_id[c_id] == "c", "Trace A did not preserve the live addition's stable ID")
  end
elseif scenario == "compatible-rename" then
  replace_name(alpha, "AA")
  control({ "rename-session", "-t", beta, "--", "Bee" })
  local ok, result = save()
  expect(ok, "compatible live rename was rejected: " .. first_line(result))
  if ok then expect_names(M.snapshot(), { "AA", "Bee" }, "compatible rename final names") end
elseif scenario == "equal-rename" then
  replace_name(alpha, "Theirs")
  control({ "rename-session", "-t", alpha, "--", "Theirs" })
  local ok, result = save()
  expect(ok, "equal concurrent rename was rejected: " .. first_line(result))
  if ok then expect_names(M.snapshot(), { "Theirs", "beta" }, "equal rename final names") end
elseif scenario == "trace-b" then
  delete_row(beta)
  control({ "kill-session", "-t", gamma })
  local ok, result = save()
  expect(ok, "Trace B compatible child/unrelated deletion was rejected: " .. first_line(result))
  if ok then
    local after = M.snapshot()
    expect_names(after, { "alpha" }, "Trace B final names")
    expect(after.by_id[alpha] == "alpha", "Trace B deleted the parent")
    expect(after.by_id[beta] == nil and after.by_id[gamma] == nil,
      "Trace B retained a deleted session")
  end
elseif scenario == "compatible-parent" then
  local other = id_named(baseline, "other")
  replace_name(alpha, "ParentMine")
  control({ "set-option", "-t", beta, "@pi_subagent_parent_id", other })
  local ok, result = save()
  expect(ok, "compatible live parent change was rejected: " .. first_line(result))
  if ok then
    local after = M.snapshot()
    expect(after.by_id[alpha] == "ParentMine", "parent rename did not retain its stable ID")
    expect(after.parent_option_by_id[beta] == other,
      "compatible parent change was not preserved")
  end
elseif scenario == "trace-c" then
  replace_name(alpha, "Mine")
  control({ "rename-session", "-t", alpha, "--", "Theirs" })
  local ok, result, report = save()
  local text = tostring(result)
  expect(not ok, "Trace C divergent rename silently succeeded")
  no_operations(report, "Trace C conflict")
  expect(has_row(alpha, "Mine"), "Trace C did not preserve the local buffer choice")
  expect(M.ui_active and M.timer ~= nil, "Trace C stopped polling after conflict")
  expect(has_text(text, "conflict") and has_text(text, alpha) and has_text(text, "name"),
    "Trace C conflict omitted the stable ID or changed name field")
  expect(has_text(log_text(), alpha) and has_text(log_text(), "name"),
    "Trace C diagnostic omitted the stable ID or changed name field")
elseif scenario == "external-delete-edited" then
  replace_name(alpha, "Mine")
  control({ "kill-session", "-t", alpha })
  local ok, result, report = save()
  local text = tostring(result)
  expect(not ok, "edited target deletion silently succeeded")
  no_operations(report, "edited-target deletion conflict")
  expect(has_row(alpha, "Mine"), "edited-target deletion lost the local buffer edit")
  expect(M.ui_active and M.timer ~= nil, "edited-target deletion stopped polling")
  expect(has_text(text, "deleted") and has_text(text, alpha) and has_text(text, "name"),
    "edited-target deletion omitted the stable ID or changed name field")
elseif scenario == "local-delete-live-renamed" then
  delete_row(alpha)
  control({ "rename-session", "-t", alpha, "--", "Theirs" })
  local ok, result, report = save()
  local text = tostring(result)
  expect(not ok, "local deletion of live-renamed target silently succeeded")
  no_operations(report, "delete/live-rename conflict")
  expect(M.snapshot().by_id[alpha] == "Theirs", "delete/live-rename mutated the live target")
  expect(not has_row(alpha, "A"), "delete/live-rename restored a local row")
  expect(M.ui_active and M.timer ~= nil, "delete/live-rename stopped polling")
  expect(has_text(text, "renam") and has_text(text, alpha) and has_text(text, "name"),
    "delete/live-rename omitted the stable ID or changed name field")
elseif scenario == "already-deleted-local" then
  delete_row(alpha)
  control({ "kill-session", "-t", alpha })
  local ok, result = save()
  expect(ok, "already externally deleted local deletion was not satisfied: " .. first_line(result))
  if ok then expect_names(M.snapshot(), { "beta" }, "already-deleted final names") end
elseif scenario == "repeated-failure" then
  replace_name(alpha, "Mine")
  control({ "rename-session", "-t", alpha, "--", "Theirs" })
  local ok1, err1, report1 = save()
  local first_buffer = has_row(alpha, "Mine")
  local ok2, err2, report2 = save()
  expect(not ok1 and not ok2, "repeated conflict did not fail both saves")
  no_operations(report1, "first repeated conflict")
  no_operations(report2, "second repeated conflict")
  expect(first_buffer and has_row(alpha, "Mine"), "repeated conflict lost the local edit")
  expect(M.ui_active and M.timer ~= nil, "repeated conflict left polling inactive")
  expect(has_text(err1, alpha) and has_text(err2, alpha),
    "repeated conflict did not identify the stable ID on both attempts")
elseif scenario == "conflict-recovery" then
  replace_name(alpha, "Mine")
  control({ "rename-session", "-t", alpha, "--", "Theirs" })
  local first_ok, first_error, first_report = save()
  expect(not first_ok, "conflict recovery setup did not reject the divergent rename")
  no_operations(first_report, "conflict recovery first save")
  expect(has_row(alpha, "Mine"), "conflict recovery lost local edit before explicit choice")
  expect(M.ui_active and M.timer ~= nil, "conflict recovery stopped polling before choice")
  local refresh_ok, refresh_error = pcall(vim.cmd, "TmuxOilRefresh")
  expect(refresh_ok, "explicit refresh raised a command error: " .. tostring(refresh_error))
  expect(has_row(alpha, "Mine") and vim.bo[M.buf].modified,
    "conflicting refresh silently discarded the local edit")
  replace_name(alpha, "Theirs")
  local second_ok, second_result = save()
  expect(second_ok, "accept-live in-buffer recovery failed: " .. first_line(second_result))
  if second_ok then expect_names(M.snapshot(), { "Theirs", "beta" }, "conflict recovery final names") end
elseif scenario == "live-order" then
  control({ "move-session", "-b", "-s", beta, "-t", alpha })
  local ok, result = save()
  expect(ok, "unchanged local order did not adopt live order: " .. first_line(result))
  if ok then expect_names(M.snapshot(), { "beta", "alpha", "gamma" }, "live-order final names") end
elseif scenario == "local-order-addition" then
  reorder({ beta, alpha })
  control({ "new-session", "-d", "-s", "c", "sleep 120" })
  local c_id = control({ "display-message", "-p", "-t", "c", "#{session_id}" }):gsub("%s+$", "")
  local ok, result = save()
  expect(ok, "local reorder with live addition was rejected: " .. first_line(result))
  if ok then
    local after = M.snapshot()
    expect_names(after, { "beta", "c", "alpha" }, "local-order-addition final names")
    expect(after.by_id[c_id] == "c", "local-order-addition did not preserve the live addition's stable ID")
  end
elseif scenario == "equal-order" then
  reorder({ beta, alpha, gamma })
  control({ "move-session", "-b", "-s", beta, "-t", alpha })
  local ok, result = save()
  expect(ok, "equal concurrent reorder was rejected: " .. first_line(result))
  if ok then expect_names(M.snapshot(), { "beta", "alpha", "gamma" }, "equal-order final names") end
elseif scenario == "local-order-deleted" then
  reorder({ beta, alpha, gamma })
  control({ "kill-session", "-t", beta })
  local ok, result, report = save()
  local text = tostring(result)
  expect(not ok, "local reorder of externally deleted target silently succeeded")
  no_operations(report, "local-order/deleted conflict")
  expect_names(M.snapshot(), { "alpha", "gamma" }, "local-order/deleted live names")
  expect(vim.deep_equal(ids_in_buffer(), { beta, alpha, gamma }),
    "local-order/deleted lost the local order")
  expect(M.ui_active and M.timer ~= nil, "local-order/deleted stopped polling")
  expect(has_text(text, "delet") and has_text(text, beta) and has_text(text, "order"),
    "local-order/deleted conflict omitted the stable ID or changed ordering field")
elseif scenario == "divergent-order" then
  reorder({ beta, alpha, gamma })
  control({ "move-session", "-b", "-s", gamma, "-t", beta })
  local ok, result, report = save()
  local text = tostring(result)
  expect(not ok, "divergent concurrent reorder silently succeeded")
  no_operations(report, "divergent-order conflict")
  expect(vim.deep_equal(names_in_order(M.snapshot()), { "alpha", "gamma", "beta" }),
    "divergent-order mutated live ordering")
  expect(vim.deep_equal(ids_in_buffer(), { beta, alpha, gamma }),
    "divergent-order lost the local order")
  expect(has_text(text, "order") and has_text(text, alpha) and has_text(text, beta),
    "divergent-order conflict omitted the stable IDs or ordering field")
end

if #failures > 0 then
  error("reconcile " .. scenario .. " failed:\n - " .. table.concat(failures, "\n - "), 0)
end
io.stdout:write("PASS reconcile " .. scenario .. "\n")
io.stdout:flush()
LUA

  TMUX="$socket_path,$server_pid,0" \
  TMUX_OIL_ERROR_DIR="$tmp/errors" \
  TMUX_OIL_TEST_LUA="$tmp/reconcile.lua" \
  TMUX_OIL_TEST_SCENARIO="$scenario" \
  TMUX_OIL_TEST_SOCKET="$socket" \
  ./scripts/tmux-oil
}

run_order_case() {
  scenario=$1
  TMUX_BIN=$2
  socket="tmux-oil-order-${scenario}-$$-$(date +%s)"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tmux-oil-order.XXXXXX")
  socket_path=
  cleanup_order() {
    status=$?
    trap - EXIT HUP INT TERM
    "$TMUX_BIN" -L "$socket" -f /dev/null kill-server >/dev/null 2>&1 || status=1
    [ -n "$socket_path" ] && rm -f "$socket_path"
    rm -rf "$tmp"
    [ -n "$socket_path" ] && [ ! -e "$socket_path" ] || status=1
    exit "$status"
  }
  trap cleanup_order EXIT
  trap 'exit 1' HUP INT TERM

  printf 'ordering_binary=%s throwaway_socket=%s scenario=%s\n' \
    "$TMUX_BIN" "$socket" "$scenario"
  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s alpha 'sleep 120'
  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s beta 'sleep 120'
  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s gamma 'sleep 120'
  socket_path=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p '#{socket_path}')
  server_pid=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p '#{pid}')

  cat >"$tmp/order.lua" <<'LUA'
local M = assert(_G.tmux_oil)
local scenario = assert(vim.env.TMUX_OIL_TEST_SCENARIO)
local control_socket = assert(vim.env.TMUX_OIL_TEST_SOCKET)
local tmux_bin = assert(vim.env.TMUX_OIL_TMUX_BIN)

local function check(value, message)
  if not value then error(message, 0) end
end
local function control(args)
  local argv = { tmux_bin, "-L", control_socket, "-f", "/dev/null" }
  vim.list_extend(argv, args)
  local result = vim.system(argv, { text = true }):wait()
  check(result.code == 0, (result.stderr or "throwaway tmux command failed"):gsub("%s+$", ""))
  return result.stdout or ""
end
local function id_named(state, name)
  for id, value in pairs(state.by_id) do
    if value == name then return id end
  end
  error("missing session " .. name, 0)
end
local function listing(label, state)
  io.stdout:write(label .. "_ORDER_ID_LISTING:\n" .. M.render(state) .. "\n")
end
local function intent(text)
  io.stdout:write("INTENT_ORDER_ID_LISTING:\n" .. text .. "\n")
end
local function check_order(state, wanted, message)
  check(vim.deep_equal(state.order, wanted), message .. ": " .. table.concat(state.order, ","))
end

local baseline = M.snapshot()
listing("BEFORE", baseline)
local alpha = id_named(baseline, "alpha")
local beta = id_named(baseline, "beta")
local gamma = id_named(baseline, "gamma")

if scenario == "reorder" then
  check(M.persistent_order, "patched server capability was not detected")
  local text = gamma .. '\t"gamma"\n' .. alpha .. '\t"alpha"\n' .. beta .. '\t"beta"'
  intent(text)
  M.apply(baseline, M.parse_manifest(text, baseline))
  local after = M.snapshot()
  listing("AFTER", after)
  check_order(after, { gamma, alpha, beta }, "reorder intent was not applied exactly")
elseif scenario == "combined" then
  check(M.persistent_order, "patched server capability was not detected")
  local text = gamma .. '\t"gamma-renamed"\n+\t"delta-created"\n'
    .. alpha .. '\t"alpha-renamed"'
  intent(text)
  M.apply(baseline, M.parse_manifest(text, baseline))
  local after = M.snapshot()
  local delta = id_named(after, "delta-created")
  listing("AFTER", after)
  check(after.by_id[gamma] == "gamma-renamed" and after.by_id[alpha] == "alpha-renamed",
    "combined apply did not retain renamed stable IDs")
  check(after.by_id[beta] == nil, "combined apply did not kill the requested stable ID")
  check_order(after, { gamma, delta, alpha }, "combined apply final order is wrong")
elseif scenario == "drift" then
  check(M.persistent_order, "patched server capability was not detected")
  local text = gamma .. '\t"gamma"\n' .. alpha .. '\t"alpha"\n' .. beta .. '\t"beta"'
  intent(text)
  control({ "move-session", "-b", "-s", beta, "-t", alpha })
  local immediately_before = M.snapshot()
  listing("IMMEDIATELY_BEFORE_APPLY", immediately_before)
  local ok, err = pcall(M.apply, baseline, M.parse_manifest(text, baseline))
  check(not ok and tostring(err):find("structural drift detected", 1, true),
    "external reorder drift was not rejected")
  local after = M.snapshot()
  listing("AFTER", after)
  check(vim.deep_equal(immediately_before, after), "reorder drift rejection mutated state")
elseif scenario == "fallback" then
  check(not M.persistent_order, "unpatched server incorrectly reported ordering capability")
  local text = gamma .. '\t"gamma"\n' .. alpha .. '\t"alpha-renamed"\n'
    .. beta .. '\t"beta"'
  intent(text)
  local report = M.apply(baseline, M.parse_manifest(text, baseline))
  local after = M.snapshot()
  listing("AFTER", after)
  check(report.warning
      and report.warning:find("lacks move-session", 1, true)
      and report.warning:find("not persisted", 1, true)
      and report.warning:find("restart with the patched tmux", 1, true),
    "fallback warning was missing or not actionable")
  check(after.by_id[alpha] == "alpha-renamed", "fallback did not apply non-order rename")
  check_order(after, { alpha, beta, gamma }, "fallback unexpectedly changed server order")
  for _, argv in ipairs(report.attempted) do
    check(not vim.tbl_contains(argv, "move-session"), "fallback attempted move-session")
  end
  io.stdout:write("FALLBACK_WARNING=" .. report.warning .. "\n")
else
  error("unknown order scenario " .. scenario, 0)
end
io.stdout:flush()
LUA

  PATH=$(dirname "$TMUX_BIN"):$PATH \
  TMUX="$socket_path,$server_pid,0" \
  TMUX_OIL_TEST_LUA="$tmp/order.lua" \
  TMUX_OIL_TEST_SOCKET="$socket" \
  TMUX_OIL_TEST_SCENARIO="$scenario" \
  ./scripts/tmux-oil
}

run_order_suite() {
  cap_socket="tmux-oil-capability-$$-$(date +%s)"
  "$PATCHED_TMUX_BIN" -L "$cap_socket" -f /dev/null new-session -d -s capability 'sleep 30'
  "$PATCHED_TMUX_BIN" -L "$cap_socket" -f /dev/null list-commands move-session >/dev/null
  "$PATCHED_TMUX_BIN" -L "$cap_socket" -f /dev/null kill-server
  printf 'PASS capability detection uses patched binary path %s\n' "$PATCHED_TMUX_BIN"

  run_order_case reorder "$PATCHED_TMUX_BIN"
  printf '%s\n' 'PASS reordered manifest rows persist exact stable-ID order'
  run_order_case combined "$PATCHED_TMUX_BIN"
  printf '%s\n' 'PASS rename create kill and reorder produce exact final order'
  run_order_case drift "$PATCHED_TMUX_BIN"
  printf '%s\n' 'PASS external reorder drift is rejected without mutation'

  vanilla_package=$(nix eval --raw nixpkgs#tmux.outPath)
  nix build --no-link nixpkgs#tmux >/dev/null
  vanilla_tmux=$vanilla_package/bin/tmux
  run_order_case fallback "$vanilla_tmux"
  printf '%s\n' 'PASS unpatched fallback warns and applies non-order operations'
}

run_ui_case() {
  TMUX_BIN=$(command -v tmux)
  socket="tmux-oil-seg3-ui-$$-$(date +%s)"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tmux-oil-ui-test.XXXXXX")
  runtime="$tmp/runtime"
  mkdir -p "$runtime" "$tmp/xdg/nvim"
  printf '%s\n' 'vim.g.daily_config_loaded = true' >"$tmp/xdg/nvim/init.lua"
  socket_path=
  cleanup_ui() {
    status=$?
    trap - EXIT HUP INT TERM
    "$TMUX_BIN" -L "$socket" -f /dev/null kill-server >/dev/null 2>&1 || true
    [ -n "$socket_path" ] && rm -f "$socket_path"
    rm -rf "$tmp"
    if [ -n "$socket_path" ] && [ ! -e "$socket_path" ]; then
      printf 'cleanup_socket_removed=yes path=%s\n' "$socket_path"
    else
      printf 'cleanup_socket_removed=no path=%s\n' "${socket_path:-unknown}" >&2
      status=1
    fi
    exit "$status"
  }
  trap cleanup_ui EXIT
  trap 'exit 1' HUP INT TERM

  printf 'throwaway_socket=%s mode=ui\n' "$socket"
  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s alpha 'sleep 120'
  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s beta 'sleep 120'
  "$TMUX_BIN" -L "$socket" -f /dev/null set-option -t alpha \
    @pi_cache_session '#[fg=yellow]BUSY#[default] countdown=9s ctx=10% cost=$1.00'
  socket_path=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p '#{socket_path}')
  server_pid=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p '#{pid}')

  cat >"$tmp/ui.lua" <<'LUA'
local M = assert(_G.tmux_oil)
local control_socket = assert(vim.env.TMUX_OIL_TEST_SOCKET)
local tmux_bin = assert(vim.env.TMUX_OIL_TMUX_BIN)

local function check(value, message)
  if not value then error(message, 0) end
end
local function control(args)
  local argv = { tmux_bin, "-L", control_socket, "-f", "/dev/null" }
  vim.list_extend(argv, args)
  local result = vim.system(argv, { text = true }):wait()
  check(result.code == 0, (result.stderr or "throwaway tmux command failed"):gsub("%s+$", ""))
  return result.stdout or ""
end
local function wait_for(predicate, message)
  check(vim.wait(3000, predicate, 10), message)
end
local function lines()
  return vim.api.nvim_buf_get_lines(M.buf, 0, -1, false)
end
local function annotations()
  local result = {}
  for _, mark in ipairs(vim.api.nvim_buf_get_extmarks(M.buf, M.ns, 0, -1,
    { details = true })) do
    local text = M.annotation_text(mark[4])
    if text ~= "" then result[#result + 1] = mark[2] .. ":" .. text end
  end
  table.sort(result)
  return result
end
local function annotation_ids()
  local result = {}
  for _, mark in ipairs(vim.api.nvim_buf_get_extmarks(M.buf, M.ns, 0, -1, {})) do
    result[#result + 1] = mark[1]
  end
  table.sort(result)
  return result
end
local function contains(values, needle)
  return table.concat(values, "\n"):find(needle, 1, true) ~= nil
end
local function id_named(name)
  for id, value in pairs(M.baseline.by_id) do if value == name then return id end end
  error("missing session " .. name, 0)
end
local function bars(text)
  local positions = {}
  for index = 1, #text do
    if text:sub(index, index) == "|" then positions[#positions + 1] = index end
  end
  return positions
end

check(vim.deep_equal(
  bars(M.aligned_status("prefix| ctx | $ 1.00 | done", { 6, 5, 9 })),
  bars(M.aligned_status("prefix| ctx | $ 12.00 | done", { 6, 5, 9 }))),
  "status separators were not aligned")
check(vim.g.tmux_oil_init_loaded == true, "private init marker is absent")
check(vim.g.daily_config_loaded == nil, "daily Nvim config sentinel loaded")
M.start()
check(vim.o.laststatus == 0, "statusline was not removed")
wait_for(function() return M.completed_polls >= 1 and M.poll_process == nil end,
  "first metadata poll did not complete")
local alpha = id_named("alpha")
local before_lines = lines()
check(vim.fn.maparg("A", "n") ~= "", "A did not map to the JSON-safe name appender")
local original_line = before_lines[1]
vim.api.nvim_win_set_cursor(0, { 1, 0 })
M.append_name()
local insert_col = vim.api.nvim_win_get_cursor(0)[2]
check(insert_col == #original_line - 1,
  "A did not place the insert point before the concealed closing quote")
vim.api.nvim_buf_set_text(M.buf, 0, insert_col, 0, insert_col, { "renamed" })
local parsed_edit = pcall(function()
  return M.parse_manifest(vim.api.nvim_get_current_line(), M.baseline)
end)
check(parsed_edit, "A-style editing produced an invalid JSON string")
vim.api.nvim_buf_set_lines(M.buf, 0, 1, false, { original_line })
vim.bo[M.buf].modified = false
vim.cmd("stopinsert")

-- x must not eat the hidden JSON delimiters after the last name character.
check(vim.fn.maparg("x", "n") ~= "", "x did not map to safe name deletion")
local name_start = original_line:find("\t", 1, true) + 1
vim.api.nvim_win_set_cursor(0, { 1, name_start })
for _ = 1, #M.baseline.by_id[alpha] do vim.cmd("normal x") end
local empty_name_line = vim.api.nvim_get_current_line()
check(empty_name_line == alpha .. "\t\"\"", "x did not preserve empty JSON name delimiters")
vim.cmd("normal x")
check(vim.api.nvim_get_current_line() == empty_name_line,
  "x deleted a JSON delimiter from an empty name")
local empty_cursor = vim.api.nvim_win_get_cursor(0)
vim.api.nvim_buf_set_text(M.buf, 0, empty_cursor[2], 0, empty_cursor[2], { "renamed" })
local safe_rename = pcall(function()
  return M.parse_manifest(vim.api.nvim_get_current_line(), M.baseline)
end)
check(safe_rename, "x then rename produced an invalid JSON string")
vim.api.nvim_buf_set_lines(M.buf, 0, 1, false, { original_line })
vim.bo[M.buf].modified = false
local restored_completed = M.completed_polls
M.poll()
wait_for(function() return M.completed_polls > restored_completed and M.poll_process == nil end,
  "poll after name-edit test did not complete")
local before_tick = vim.b.changedtick
local before_modified = vim.bo[M.buf].modified
local before_undo = vim.fn.undotree().seq_cur
local before_marks = annotations()
local before_mark_ids = annotation_ids()
local unchanged_completed = M.completed_polls
M.poll()
wait_for(function() return M.completed_polls > unchanged_completed and M.poll_process == nil end,
  "unchanged metadata poll did not complete")
check(vim.deep_equal(before_mark_ids, annotation_ids()),
  "unchanged poll recreated annotation extmarks")
check(M.last_metadata[alpha]
    == '#[fg=yellow]BUSY#[default] countdown=9s ctx=10% cost=$1.00',
  "metadata was not matched by stable session ID")
check(contains(before_marks, 'BUSY countdown=9s ctx=10% cost=$1.00')
    and not contains(before_marks, '#[fg='),
  "first poll did not render clean virtual text")

-- Issue: a highlight used to stop at the visible name instead of covering
-- the whole horizontal space. Drags (and v) must open line-wise selections.
check(vim.fn.maparg("v", "n") == "V", "v did not map to a line-wise selection")
check(vim.fn.maparg("<LeftDrag>", "n") ~= "", "left drag did not map to a line-wise handler")
check(vim.fn.maparg("<LeftDrag>", "v") ~= "", "visual-mode drag did not map to a line-wise handler")
vim.api.nvim_win_set_cursor(0, { 1, 0 })
M.drag_linewise({ line = 1, column = 0 })
check(vim.fn.mode() == "V", "drag did not open a line-wise selection")
check(vim.api.nvim_win_get_cursor(0)[1] == 1, "drag did not anchor on the dragged row")
M.drag_linewise({ line = 2, column = 0 })
check(vim.api.nvim_win_get_cursor(0)[1] == 2, "drag did not extend onto the dragged row")
local visual_marks = vim.api.nvim_buf_get_extmarks(M.buf, M.visual_ns, 0, -1, { details = true })
check(#visual_marks == 2 and #vim.tbl_filter(function(mark)
  return mark[4].line_hl_group == "Visual"
end, visual_marks) == 2, "whole-line Visual paint did not cover exactly the selected rows")
vim.cmd("normal! \27")
M.refresh_visual_lines()
check(#vim.api.nvim_buf_get_extmarks(M.buf, M.visual_ns, 0, -1, {}) == 0,
  "whole-line paint did not clear when visual mode ended")
vim.cmd("normal! \27")
check(vim.fn.line("'<") == 1 and vim.fn.line("'>") == 2,
  "line-wise selection did not span the dragged rows")
check(vim.b[M.buf].changedtick == before_tick and vim.bo[M.buf].modified == before_modified
    and vim.fn.undotree().seq_cur == before_undo,
  "selecting rows changed the buffer, modified flag, or undo history")
vim.api.nvim_win_set_cursor(0, { 2, 0 })
M.drag_linewise({ line = 9, column = 0 })
check(vim.fn.mode() == "V" and vim.api.nvim_win_get_cursor(0)[1]
    == vim.api.nvim_buf_line_count(M.buf), "drag past the last row did not clamp")
vim.cmd("normal! \27")
M.drag_linewise({ line = 0, column = 0 })
check(vim.fn.mode() == "n", "drag outside the rows started a selection")
M.drag_linewise(nil)
check(vim.fn.mode() == "n", "drag without a mouse position started a selection")
vim.api.nvim_win_set_cursor(0, { 2, 0 })
vim.cmd("normal! v")
vim.cmd("normal! j")
M.drag_linewise({ line = 1, column = 0 })
check(vim.fn.mode() == "V", "drag did not convert a running selection to line-wise")
vim.cmd("normal! \27")
check(vim.fn.line("'<") == 1 and vim.fn.line("'>") == 2,
  "converted selection did not span the running rows")
M.drag_linewise({ line = 2, column = 0 })
vim.cmd("normal! \27")

control({ "set-option", "-t", alpha, "@pi_cache_session",
  "#[fg=green]AGENT DONE#[default] countdown=8s ctx=11% cost=$1.25" })
local completed = M.completed_polls
M.poll()
wait_for(function() return M.completed_polls > completed and M.poll_process == nil end,
  "metadata tick did not complete")
local after_lines = lines()
local after_marks = annotations()
local after_tick = vim.b.changedtick
local after_modified = vim.bo[M.buf].modified
local after_undo = vim.fn.undotree().seq_cur
check(vim.deep_equal(before_lines, after_lines), "metadata tick changed real buffer lines")
check(contains(after_marks, "AGENT DONE countdown=8s ctx=11% cost=$1.25"),
  "metadata tick did not update virtual text")
check(not contains(after_marks, "BUSY countdown=9s"), "old metadata extmark remained")
check(before_tick == after_tick and before_modified == after_modified
  and before_undo == after_undo, "metadata tick changed edit or undo state")

local reordered_lines = { before_lines[2], before_lines[1] }
vim.api.nvim_buf_set_lines(M.buf, 0, -1, false, reordered_lines)
completed = M.completed_polls
M.poll()
wait_for(function() return M.completed_polls > completed and M.poll_process == nil end,
  "reordered unchanged metadata poll did not complete")
local agent_done_row
for _, mark in ipairs(vim.api.nvim_buf_get_extmarks(M.buf, M.ns, 0, -1,
  { details = true })) do
  if M.annotation_text(mark[4]):find("AGENT DONE", 1, true) then
    agent_done_row = mark[2] + 1
  end
end
check(agent_done_row == 2 and lines()[agent_done_row]:find('\t"alpha"', 1, true),
  "buffer reorder did not move stable-ID annotation with alpha")
vim.api.nvim_buf_set_lines(M.buf, 0, -1, false, before_lines)
vim.bo[M.buf].modified = false
completed = M.completed_polls
M.poll()
wait_for(function() return M.completed_polls > completed and M.poll_process == nil end,
  "restored buffer poll did not complete")
local expected_after_resume = annotations()
M.cleanup()
check(#vim.api.nvim_buf_get_extmarks(M.buf, M.ns, 0, -1, {}) == 0,
  "cleanup did not clear live annotations")
M.resume_polling()
wait_for(function() return M.completed_polls >= 1 and M.poll_process == nil end,
  "poll after cleanup/resume did not complete")
check(vim.deep_equal(expected_after_resume, annotations()),
  "resume did not repaint unchanged metadata")

control({ "new-session", "-d", "-s", "external-created", "sleep 120" })
local topology_lines = lines()
completed = M.completed_polls
M.poll()
wait_for(function() return M.completed_polls > completed and M.poll_process == nil end,
  "topology poll did not complete")
check(vim.deep_equal(topology_lines, lines()), "external topology was merged into real lines")
check(contains(annotations(), "external sessions added"),
  "external topology warning is not visible")
control({ "kill-session", "-t", "external-created" })

local started, overlaps = M.started_polls, M.overlapping_polls
M.poll()
M.poll()
wait_for(function()
  return M.started_polls >= started + 2 and M.poll_process == nil
end, "coalesced poll did not finish")
check(M.overlapping_polls == overlaps + 1, "overlapping poll was not coalesced")

local ordered = false
M.test_before_final_reread = function()
  check(M.timer == nil and M.poll_process == nil and not M.ui_active,
    "save reached final reread before poll shutdown")
  ordered = true
end
M.poll()
local save_ok, save_error = pcall(vim.cmd, "write")
M.test_before_final_reread = nil
check(save_ok, save_error or "unchanged save failed")
check(ordered, "final-reread ordering hook did not run")
check(vim.api.nvim_buf_is_valid(M.buf) and vim.api.nvim_get_current_buf() == M.buf
    and M.ui_active and M.timer ~= nil,
  ":w did not keep the editor open and live")
wait_for(function() return M.completed_polls >= 1 and M.poll_process == nil end,
  "poll after restart did not complete")
vim.api.nvim_buf_set_lines(M.buf, -1, -1, false, { "created-by-plain-line" })
local create_ok, create_error = pcall(vim.cmd, "write")
check(create_ok, create_error or "plain-line create failed")
check(vim.tbl_contains(vim.tbl_values(M.baseline.by_id), "created-by-plain-line"),
  "plain new line did not create a session")
vim.api.nvim_buf_set_lines(M.buf, -1, -1, false, { "" })
local blank_ok, blank_error = pcall(vim.cmd, "write")
check(blank_ok, blank_error or "blank line was not ignored")
vim.api.nvim_buf_set_lines(M.buf, -1, -1, false, { "bad:name" })
local write_ok, write_error = pcall(vim.cmd, "write")
local helpful_error = tostring(M.last_error)
check(write_ok, "failed save rethrew a BufWriteCmd error: " .. tostring(write_error))
check(helpful_error:find("tmux%-oil") and helpful_error:find("Diagnostic saved to:", 1, true)
    and helpful_error:find("completed", 1, true) and helpful_error:find("pending", 1, true),
  "failed save did not return one concise diagnostic summary")
check(vim.api.nvim_buf_is_valid(M.buf) and vim.api.nvim_get_current_buf() == M.buf
    and vim.bo[M.buf].modified,
  "failed save did not retain the dirty editor buffer")
local error_files = vim.fn.glob(vim.env.TMUX_OIL_ERROR_DIR .. "/*.log", false, true)
check(#error_files == 1, "failed save did not write exactly one diagnostic file")
local saved_error = table.concat(vim.fn.readfile(error_files[1]), "\n")
check(saved_error:find("tmux%-oil save failure")
    and saved_error:find("plain line like: work", 1, true),
  "diagnostic file did not preserve the full save error")

io.stdout:write("BUFFER_BEFORE_METADATA_TICK=" .. vim.json.encode(before_lines) .. "\n")
io.stdout:write("BUFFER_AFTER_METADATA_TICK=" .. vim.json.encode(after_lines) .. "\n")
io.stdout:write("EXTMARKS_BEFORE_METADATA_TICK=" .. vim.json.encode(before_marks) .. "\n")
io.stdout:write("EXTMARKS_AFTER_METADATA_TICK=" .. vim.json.encode(after_marks) .. "\n")
io.stdout:write("b:modified before=" .. tostring(before_modified)
  .. " after=" .. tostring(after_modified) .. "\n")
io.stdout:write("b:changedtick before=" .. before_tick .. " after=" .. after_tick .. "\n")
io.stdout:write("undo_seq before=" .. before_undo .. " after=" .. after_undo .. "\n")
for _, result in ipairs({
  "PASS self-contained init loaded",
  "PASS daily Nvim config sentinel did not load",
  "PASS statusline is removed",
  "PASS first poll creates stable-ID-matched virtual text",
  "PASS unchanged poll preserves annotation extmark IDs",
  "PASS ticking metadata changes extmark without changing lines",
  "PASS ticking metadata leaves modified flag and undo history unchanged",
  "PASS buffer reorder remaps stable-ID annotations",
  "PASS cleanup and resume repaint unchanged metadata",
  "PASS external topology change is visibly flagged but not merged",
  "PASS overlapping polls are suppressed or coalesced",
  "PASS :wq stops timer and in-flight poll before final reread",
  "PASS plain new line creates a session on save",
  "PASS blank lines are ignored on save",
  "PASS validation error explains plain and encoded row forms",
  "PASS failed save remains open",
  "PASS drag and v highlights cover the whole row",
}) do io.stdout:write(result .. "\n") end
io.stdout:flush()
LUA

  TMUX="$socket_path,$server_pid,0" \
  TMPDIR="$runtime" \
  XDG_CONFIG_HOME="$tmp/xdg" \
  TMUX_OIL_ERROR_DIR="$tmp/errors" \
  TMUX_OIL_TEST_LUA="$tmp/ui.lua" \
  TMUX_OIL_TEST_SOCKET="$socket" \
  ./scripts/tmux-oil

  cat >"$tmp/success.lua" <<'LUA'
local M = assert(_G.tmux_oil)
M.start()
vim.api.nvim_create_autocmd("VimLeavePre", {
  once = true,
  callback = function()
    local file = assert(io.open(assert(vim.env.TMUX_OIL_POPUP_MARKER), "w"))
    file:write("popup-save-exited\n")
    file:close()
  end,
})
vim.defer_fn(function() vim.cmd("wq") end, 100)
LUA
  marker="$tmp/popup-exited"
  popup_command="env TMUX_OIL_TEST_LUA=$tmp/success.lua TMUX_OIL_TEST_STAY=1 TMUX_OIL_POPUP_MARKER=$marker TMPDIR=$runtime XDG_CONFIG_HOME=$tmp/xdg $PWD/scripts/tmux-oil"
  printf 'popup_launch=tmux -L %s display-popup -E %s\n' "$socket" "$popup_command"
  ( sleep 3; "$TMUX_BIN" -L "$socket" -f /dev/null kill-server >/dev/null 2>&1 || true ) &
  server_killer=$!
  set +e
  env -u TMUX -u TMUX_PANE TERM=xterm-256color script -q /dev/null \
    "$TMUX_BIN" -L "$socket" -f /dev/null attach-session -t alpha \
    \; display-popup -E "$popup_command" >/dev/null 2>&1
  pty_status=$?
  set -e
  wait "$server_killer"
  printf 'pty_transport_exit=%s (server deliberately stopped after popup exit)\n' "$pty_status"
  grep -q '^popup-save-exited$' "$marker"
  printf '%s\n' 'PASS successful save exits popup'

  if find "$runtime" -name 'tmux-oil.*' -print -quit | grep -q .; then
    printf '%s\n' 'tmux-oil private temporary files leaked' >&2
    return 1
  fi
}

run_tree_case() {
  TMUX_BIN=$(command -v tmux)
  socket="tmux-oil-tree-$$-$(date +%s)"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tmux-oil-tree.XXXXXX")
  socket_path=
  cleanup_tree() {
    status=$?
    trap - EXIT HUP INT TERM
    "$TMUX_BIN" -L "$socket" -f /dev/null kill-server >/dev/null 2>&1 || status=1
    [ -n "$socket_path" ] && rm -f "$socket_path"
    rm -rf "$tmp"
    [ -n "$socket_path" ] && [ ! -e "$socket_path" ] || status=1
    exit "$status"
  }
  trap cleanup_tree EXIT
  trap 'exit 1' HUP INT TERM

  printf 'throwaway_socket=%s mode=tree\n' "$socket"
  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s alpha 'sleep 120'
  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s beta 'sleep 120'
  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s gamma 'sleep 120'
  alpha_id=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p -t alpha '#{session_id}')
  "$TMUX_BIN" -L "$socket" -f /dev/null set-option -t beta @pi_subagent_parent_id "$alpha_id"
  "$TMUX_BIN" -L "$socket" -f /dev/null set-option -t gamma @pi_subagent_parent_id '$999'
  "$TMUX_BIN" -L "$socket" -f /dev/null set-option -t alpha \
    @pi_cache_session '#[fg=yellow]BUSY#[default] countdown=9s ctx=10% cost=$1.00'
  "$TMUX_BIN" -L "$socket" -f /dev/null set-option -t beta \
    @pi_cache_session '#[fg=green]AGENT DONE#[default] countdown=8s ctx=11% cost=$1.25'
  socket_path=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p '#{socket_path}')
  server_pid=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p '#{pid}')

  cat >"$tmp/tree.lua" <<'LUA'
local M = assert(_G.tmux_oil)

local function check(value, message)
  if not value then error(message, 0) end
end
local function wait_for(predicate, message)
  check(vim.wait(3000, predicate, 10), message)
end
local function annotations()
  local result = {}
  for _, mark in ipairs(vim.api.nvim_buf_get_extmarks(M.buf, M.ns, 0, -1,
    { details = true })) do
    local text = M.annotation_text(mark[4])
    if text ~= "" then result[#result + 1] = mark[2] .. ":" .. text end
  end
  table.sort(result)
  return result
end
local baseline = M.snapshot()
local alpha, beta, gamma = baseline.order[1], baseline.order[2], baseline.order[3]
check(baseline.by_id[alpha] == "alpha" and baseline.by_id[beta] == "beta"
  and baseline.by_id[gamma] == "gamma", "snapshot did not preserve names")
check(baseline.tree_prefix_by_id[beta] == " └── ",
  "tagged child did not get a tree prefix")
check((baseline.tree_prefix_by_id[gamma] or "") == "",
  "orphaned parent tag did not fall back to a root row")
check((baseline.tree_prefix_by_id[alpha] or "") == "",
  "parent row unexpectedly carried a prefix")

M.start()
wait_for(function() return M.completed_polls >= 1 and M.poll_process == nil end,
  "first metadata poll did not complete")
local marks = table.concat(annotations(), "\n")
check(marks:find(" └── ", 1, true) ~= nil, "tree prefix was not rendered")
check(marks:find("[✓] ", 1, true) ~= nil, "AGENT DONE did not render a green check marker")
check(marks:find("[~] ", 1, true) ~= nil, "BUSY did not render a yellow working marker")
check(marks:find("[ ] ", 1, true) ~= nil, "plain tmux session did not render a plain marker")
check(marks:find("[orphan $999] ", 1, true) ~= nil,
  "missing parent did not render an orphan marker")
check(not marks:find("#%[", 1), "style markup leaked into rendered text")
for row, line in ipairs(vim.api.nvim_buf_get_lines(M.buf, 0, -1, false)) do
  check(line:match("^(%$%d+)\t\".*\"$") ~= nil,
    "tree rendering changed real buffer line " .. row)
end

local unchanged = M.render(M.baseline)
M.apply(M.baseline, M.parse_manifest(unchanged, M.baseline))
check(vim.tbl_count(M.snapshot().by_id) == 3,
  "unchanged save did not keep all three sessions alive")

io.stdout:write("TREE_ANNOTATIONS=" .. vim.json.encode(annotations()) .. "\n")
for _, result in ipairs({
  "PASS tagged child renders with tree prefix",
  "PASS orphaned parent tag renders as a marked root",
  "PASS status markers map done working and plain sessions",
  "PASS tree rendering leaves buffer lines untouched",
  "PASS unchanged save keeps parent metadata sessions alive",
}) do io.stdout:write(result .. "\n") end
io.stdout:flush()
LUA

  TMUX="$socket_path,$server_pid,0" \
  TMUX_OIL_TEST_LUA="$tmp/tree.lua" \
  TMUX_OIL_TEST_SOCKET="$socket" \
  ./scripts/tmux-oil
}

run_popup_open_case() {
  TMUX_BIN=$(command -v tmux)
  launcher=${TMUX_OIL_LAUNCHER_UNDER_TEST:-$PWD/scripts/tmux-oil}
  socket="tmux-oil-popup-open-$$-$(date +%s)"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tmux-oil-popup-open.XXXXXX")
  capture="$tmp/pty"
  marker="$tmp/launcher-exit"
  socket_path=
  cleanup_popup_open() {
    status=$?
    trap - EXIT HUP INT TERM
    "$TMUX_BIN" -L "$socket" -f /dev/null kill-server >/dev/null 2>&1 || status=1
    [ -n "$socket_path" ] && rm -f "$socket_path"
    rm -rf "$tmp"
    [ -n "$socket_path" ] && [ ! -e "$socket_path" ] || status=1
    exit "$status"
  }
  trap cleanup_popup_open EXIT
  trap 'exit 1' HUP INT TERM

  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s alpha 'sleep 120'
  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s beta 'sleep 120'
  socket_path=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p '#{socket_path}')
  before=$("$TMUX_BIN" -L "$socket" -f /dev/null list-sessions \
    -F '#{session_created}\t#{session_id}\t#{session_name}')

  cat >"$tmp/wrapper" <<'SH'
#!/bin/sh
set +e
"$TMUX_OIL_LAUNCHER_UNDER_TEST"
status=$?
printf '%s\n' "$status" >"$TMUX_OIL_EXIT_MARKER"
exit "$status"
SH
  chmod 700 "$tmp/wrapper"
  popup_command="env TMUX_OIL_LAUNCHER_UNDER_TEST=$launcher TMUX_OIL_EXIT_MARKER=$marker $tmp/wrapper"

  set +e
  (
    sleep 1
    if [ ! -f "$marker" ]; then
      printf ':set conceallevel=0\r'
      sleep 1
      printf ':q!\r'
    fi
    attempts=0
    while [ ! -f "$marker" ] && [ "$attempts" -lt 100 ]; do
      sleep .05
      attempts=$((attempts + 1))
    done
    sleep .1
    printf '\002d'
  ) | env -u TMUX -u TMUX_PANE TERM=xterm-256color script -q "$capture" \
    "$TMUX_BIN" -L "$socket" -f /dev/null attach-session -t alpha \
    \; display-popup -B -s 'bg=#000000,fg=#e4e4e4' \
    -w 80% -h 80% -E "$popup_command" >/dev/null 2>&1
  transport_status=$?
  set -e

  [ "$transport_status" -eq 0 ] || {
    printf 'popup-open: PTY transport exited %s\n' "$transport_status" >&2
    return 1
  }
  [ "$(cat "$marker" 2>/dev/null || true)" = 0 ] || {
    printf '%s\n' 'popup-open: launcher did not exit rc=0' >&2
    return 1
  }
  alt_screen=$(printf '\033[?1049h')
  grep -Fq "$alt_screen" "$capture" || {
    printf '%s\n' 'popup-open: alternate-screen entry was not captured' >&2
    return 1
  }
  # A terminal expands the manifest TAB to spaces; require the complete visible row.
  LC_ALL=C grep -Eq '\$[0-9]+[[:space:]]+"alpha"' "$capture" || {
    printf '%s\n' 'popup-open: no rendered stable-ID manifest row was captured' >&2
    return 1
  }
  row_offset=$(LC_ALL=C grep -aboE '\$[0-9]+[[:space:]]+"alpha"' "$capture" \
    | head -n 1 | cut -d: -f1)
  dd if="$capture" of="$tmp/opening" bs=1 count="$row_offset" 2>/dev/null
  if LC_ALL=C grep -Fq "$(printf '\342\224')" "$tmp/opening"; then
    printf '%s\n' 'popup-open: popup border flash was captured' >&2
    return 1
  fi
  black_surface=$(printf '\033[38;5;254m\033[48;5;16m')
  LC_ALL=C grep -Fq "$black_surface" "$tmp/opening" || {
    printf '%s\n' 'popup-open: first surface did not match the editor background' >&2
    return 1
  }
  after=$("$TMUX_BIN" -L "$socket" -f /dev/null list-sessions \
    -F '#{session_created}\t#{session_id}\t#{session_name}')
  [ "$before" = "$after" ] || {
    printf '%s\n' 'popup-open: launcher mutated the throwaway server' >&2
    return 1
  }
  printf '%s\n' \
    'PASS popup-open first frame matched editor, had no border flash, and preserved server state'
}

run_current_cursor_case() {
  TMUX_BIN=$(command -v tmux)
  socket="tmux-oil-current-cursor-$$-$(date +%s)"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tmux-oil-current-cursor.XXXXXX")
  socket_path=
  cleanup_current_cursor() {
    status=$?
    trap - EXIT HUP INT TERM
    "$TMUX_BIN" -L "$socket" -f /dev/null kill-server >/dev/null 2>&1 || status=1
    [ -n "$socket_path" ] && rm -f "$socket_path"
    rm -rf "$tmp"
    [ -n "$socket_path" ] && [ ! -e "$socket_path" ] || status=1
    exit "$status"
  }
  trap cleanup_current_cursor EXIT
  trap 'exit 1' HUP INT TERM

  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s alpha 'sleep 120'
  "$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s beta 'sleep 120'
  socket_path=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p '#{socket_path}')

  cat >"$tmp/cursor.lua" <<'LUA'
local M = assert(_G.tmux_oil)
M.start()
local current = M.current_session_id()
local cursor = vim.api.nvim_win_get_cursor(0)
local line = vim.api.nvim_buf_get_lines(M.buf, cursor[1] - 1, cursor[1], false)[1]
assert(current == M.baseline.order[2] and M.baseline.by_id[current] == "beta",
  "popup did not resolve the attached client's non-first session")
assert(cursor[1] == 2 and line:sub(1, #current + 1) == current .. "\t",
  "cursor did not start on the current session row")
local file = assert(io.open(assert(vim.env.TMUX_OIL_CURSOR_MARKER), "w"))
file:write("context=" .. vim.env.TMUX_OIL_CURSOR_CONTEXT .. " current=" .. current
  .. " cursor_line=" .. cursor[1] .. " buffer_line=" .. line .. "\n")
file:close()
LUA

  run_context() {
    context=$1
    marker="$tmp/$context"
    popup_command="env TMUX_OIL_TEST_LUA=$tmp/cursor.lua TMUX_OIL_CURSOR_MARKER=$marker TMUX_OIL_CURSOR_CONTEXT=$context $PWD/scripts/tmux-oil"
    if [ "$context" = inside-binding ]; then
      "$TMUX_BIN" -L "$socket" -f /dev/null bind-key s \
        display-popup -B -s 'bg=#000000,fg=#e4e4e4' \
        -w 80% -h 80% -E "$popup_command"
    fi
    set +e
    (
      if [ "$context" = inside-binding ]; then sleep .5; printf '\002s'; fi
      attempts=0
      while [ ! -s "$marker" ] && [ "$attempts" -lt 100 ]; do
        sleep .05
        attempts=$((attempts + 1))
      done
      sleep .1
      printf '\002d'
    ) | if [ "$context" = outside-attach ]; then
      env -u TMUX -u TMUX_PANE TERM=xterm-256color script -q /dev/null \
        "$TMUX_BIN" -L "$socket" -f /dev/null attach-session -t beta \
        \; display-popup -B -s 'bg=#000000,fg=#e4e4e4' \
        -w 80% -h 80% -E "$popup_command"
    else
      env -u TMUX -u TMUX_PANE TERM=xterm-256color script -q /dev/null \
        "$TMUX_BIN" -L "$socket" -f /dev/null attach-session -t beta
    fi >/dev/null 2>&1
    transport_status=$?
    set -e
    [ "$transport_status" -eq 0 ]
    test -s "$marker"
    grep -q "^context=$context current=\\\$[0-9][0-9]* cursor_line=2 buffer_line=\\\$[0-9][0-9]*" "$marker"
    cat "$marker"
  }

  run_context outside-attach
  run_context inside-binding
  printf '%s\n' \
    'PASS current-session cursor targets non-first row in outside attach and inside binding popups'
}

if [ "${1-}" = all ] && [ "$#" -eq 1 ]; then
  "$0" state
  "$0" apply
  "$0" order
  "$0" ui
  "$0" tree
  "$0" popup-open
  "$0" current-cursor
  for scenario in \
    adjacent-new refresh-adjacent-new trace-a trace-b compatible-rename equal-rename \
    trace-c external-delete-edited local-delete-live-renamed already-deleted-local \
    repeated-failure conflict-recovery compatible-parent parent-tree-raw-reorder \
    parent-tree-refresh dirty-name-parent-tree-refresh parent-change-local-reorder \
    pending-reorder-refresh pristine-refresh live-order local-order-addition equal-order \
    local-order-deleted divergent-order partial-create-recovery partial-recovery
  do
    "$0" reconcile "$scenario"
  done
  exit
fi

if [ "${1-}" = reconcile ] && [ "$#" -eq 2 ]; then
  run_reconcile_case "$2"
  exit
fi

if [ "${1-}" = order ] && [ "$#" -eq 1 ]; then
  run_order_suite
  exit
fi

if [ "${1-}" = popup-open ] && [ "$#" -eq 1 ]; then
  run_popup_open_case
  exit
fi

if [ "${1-}" = current-cursor ] && [ "$#" -eq 1 ]; then
  run_current_cursor_case
  exit
fi

if [ "${1-}" = tree ] && [ "$#" -eq 1 ]; then
  run_tree_case
  exit
fi

if [ "${1-}" = _ui_case ] && [ "$#" -eq 1 ]; then
  run_ui_case
  exit
fi

if [ "${1-}" = ui ] && [ "$#" -eq 1 ]; then
  output=$(mktemp "${TMPDIR:-/tmp}/tmux-oil-ui-output.XXXXXX")
  if "$0" _ui_case >"$output" 2>&1; then
    cat "$output"
    grep -q '^cleanup_socket_removed=yes ' "$output"
    rm -f "$output"
    printf '%s\n' 'PASS all temporary files and throwaway sockets cleaned'
  else
    status=$?
    cat "$output" >&2
    rm -f "$output"
    exit "$status"
  fi
  exit
fi

if [ "${1-}" = _apply_case ] && [ "$#" -eq 2 ]; then
  run_apply_case "$2"
  exit
fi

if [ "${1-}" = apply ] && [ "$#" -eq 1 ]; then
  for result in \
    'stable|rename targets stable session ID' \
    'create-kill|create and kill produce exact requested final state' \
    'cycle|rename collision/cycle produces exact requested final state' \
    'drift|drift immediately before apply executes zero mutations' \
    'mid-failure|mid-apply tmux failure stops and reports partial state' \
    'safety|last surviving session kill is safely rejected' \
    'self-delete|deleting the invoking session keeps the ts menu alive' \
    'tree-delete|deleting an interleaved parent tree runs every planned kill'
  do
    scenario=${result%%|*}
    message=${result#*|}
    "$0" _apply_case "$scenario"
    printf 'PASS %s\n' "$message"
  done
  printf '%s\n' 'PASS every test used and cleaned a throwaway socket'
  exit
fi

if [ "${1-}" != state ] || [ "$#" -ne 1 ]; then
  printf 'usage: %s state|apply|reconcile CASE|order|ui|popup-open|current-cursor|all\n' "$0" >&2
  exit 2
fi

TMUX_BIN=$(command -v tmux)
socket="tmux-oil-seg1-state-$$-$(date +%s)"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/tmux-oil-test.XXXXXX")
socket_path=
cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  if ! "$TMUX_BIN" -L "$socket" -f /dev/null kill-server >/dev/null 2>&1; then
    status=1
  fi
  rm -rf "$tmp"
  [ -n "$socket_path" ] && rm -f "$socket_path"
  if [ -n "$socket_path" ] && [ ! -e "$socket_path" ]; then
    printf 'cleanup_socket_removed=yes path=%s\n' "$socket_path"
  else
    printf 'cleanup_socket_removed=no path=%s\n' "${socket_path:-unknown}" >&2
    status=1
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

printf 'throwaway_socket=%s\n' "$socket"
special_open='-base $; "quoted" with space'
"$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s "$special_open" 'sleep 120'
"$TMUX_BIN" -L "$socket" -f /dev/null new-session -d -s beta 'sleep 120'
socket_path=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p '#{socket_path}')
server_pid=$("$TMUX_BIN" -L "$socket" -f /dev/null display-message -p '#{pid}')

cat >"$tmp/state.lua" <<'LUA'
local M = assert(_G.tmux_oil)
local control_socket = assert(vim.env.TMUX_OIL_TEST_SOCKET)
local tmux_bin = assert(vim.env.TMUX_OIL_TMUX_BIN)

local function check(value, message)
  if not value then error(message, 0) end
end

local function control(args)
  local argv = { tmux_bin, "-L", control_socket, "-f", "/dev/null" }
  vim.list_extend(argv, args)
  local result = vim.system(argv, { text = true }):wait()
  check(result.code == 0, (result.stderr or "throwaway tmux command failed"):gsub("%s+$", ""))
  return result.stdout or ""
end

local function rejects(text, baseline)
  return not pcall(M.parse_manifest, text, baseline)
end

local function plan_rejects(baseline, intent, current)
  local ok, err = pcall(M.plan, baseline, intent, current)
  return not ok and tostring(err):find("structural drift detected", 1, true) ~= nil
end

local baseline = M.snapshot()
check(#baseline.order == 2, "opening snapshot did not contain two sessions")
local ordered = M.parse_snapshot("20\t$1\tnewer\n10\t$0\tolder")
check(ordered.order[1] == "$0" and ordered.order[2] == "$1",
  "snapshot was not ordered oldest-first by creation time")
local rendered = M.render(baseline)
local roundtrip = M.parse_manifest(rendered, baseline)
for _, id in ipairs(baseline.order) do
  check(roundtrip.existing[id] == baseline.by_id[id], "round-trip changed an ID or name")
end
local pass_roundtrip = true

local first, second = baseline.order[1], baseline.order[2]
local special = '-leading $; quote="ok" with space'
local special_create = '-create $; quote="ok" with space'
local special_text = first .. "\t" .. vim.json.encode(special) .. "\n"
  .. second .. "\t" .. vim.json.encode(baseline.by_id[second]) .. "\n"
  .. "+\t" .. vim.json.encode(special_create)
local special_plan = M.plan(baseline, M.parse_manifest(special_text, baseline), M.snapshot())
check(#special_plan.renames == 1, "special-character rename was not planned")
local special_argv = special_plan.renames[1].argv
check(#special_argv == 8 and special_argv[7] == "--" and special_argv[8] == special,
  "special-character rename was not preserved as one argv value")
local create_argv = special_plan.creates[1].argv
check(#create_argv == 7 and create_argv[6] == "-s" and create_argv[7] == special_create,
  "special-character create was not preserved as one argv value")
local jump_argv = M.jump_argv(first, baseline)
check(#jump_argv == 6 and jump_argv[4] == "switch-client"
  and jump_argv[5] == "-t" and jump_argv[6] == first,
  "jump did not use the frozen stable-ID argv mapping")
local pass_argv = true

local duplicate_id = first .. "\t\"one\"\n" .. first .. "\t\"two\""
local duplicate_name = first .. "\t\"same\"\n" .. second .. "\t\"same\""
check(rejects("malformed", baseline), "malformed row accepted")
check(rejects(duplicate_id, baseline), "duplicate ID accepted")
check(rejects("$999\t\"forged\"", baseline), "forged ID accepted")
check(rejects(first .. "\t\"name\"\textra", baseline), "unsupported third field accepted")
check(rejects("_\t\"invalid-marker\"", baseline), "invalid new-row marker accepted")
check(rejects(duplicate_name, baseline), "duplicate resulting name accepted")
check(rejects("+\t\"colon:name\"", baseline), "tmux-normalized name accepted")
check(vim.deep_equal(M.snapshot(), baseline), "validation changed throwaway state")
local pass_validation = true

local intent_text = first .. "\t\"renamed\"\n+\t\"z-create\"\n+\t\"a-create\""
local intent = M.parse_manifest(intent_text, baseline)
local deterministic = M.plan(baseline, intent, M.snapshot())
local deterministic_again = M.plan(baseline, intent, M.snapshot())
check(vim.deep_equal(deterministic, deterministic_again), "plan changed between identical inputs")
check(#deterministic.operations == 4, "deterministic plan has wrong operation count")
check(deterministic.operations[1].kind == "rename" and deterministic.operations[1].id == first,
  "deterministic rename is wrong")
check(deterministic.operations[2].kind == "create" and deterministic.operations[2].name == "a-create",
  "creates are not deterministic")
check(deterministic.operations[3].kind == "create" and deterministic.operations[3].name == "z-create",
  "creates are not deterministic")
check(deterministic.operations[4].kind == "kill" and deterministic.operations[4].id == second,
  "deterministic kill is wrong")
check(vim.deep_equal(M.snapshot(), baseline), "planning mutated throwaway state")
local pass_plan, pass_not_mutated = true, true

control({ "set-option", "-t", first, "@pi_cache_session", "BUSY 9s $4.20" })
check(not M.structural_drift(baseline, M.snapshot()), "volatile cache text caused structural drift")
local pass_cache = true

control({ "new-session", "-d", "-s", "external-create", "sleep 120" })
local after_create = M.snapshot()
check(plan_rejects(baseline, roundtrip, after_create), "external create was not rejected")
local created_id
for id, _ in pairs(after_create.by_id) do
  if baseline.by_id[id] == nil then created_id = id end
end
check(created_id ~= nil, "external create ID not found")
control({ "kill-session", "-t", created_id })
local pass_create = true

control({ "rename-session", "-t", first, "--", "external-rename" })
check(plan_rejects(baseline, roundtrip, M.snapshot()), "external rename was not rejected")
control({ "rename-session", "-t", first, "--", baseline.by_id[first] })
local pass_rename = true

control({ "kill-session", "-t", second })
check(plan_rejects(baseline, roundtrip, M.snapshot()), "external kill was not rejected")
local pass_kill = true

local results = {
  "PASS round-trip keeps stable IDs and names",
  "PASS special characters remain one argv value",
  "PASS malformed and duplicate IDs rejected before apply",
  "PASS unchanged baseline produces the expected deterministic plan",
  "PASS volatile cache-only change is not structural drift",
  "PASS external create rejected",
  "PASS external kill rejected",
  "PASS external rename rejected",
  "PASS throwaway server state was not mutated",
}
for _, line in ipairs(results) do io.stdout:write(line .. "\n") end
io.stdout:flush()
LUA

TMUX="$socket_path,$server_pid,0" \
TMUX_OIL_TEST_LUA="$tmp/state.lua" \
TMUX_OIL_TEST_SOCKET="$socket" \
./scripts/tmux-oil
