#!/bin/sh
set -eu

case "${TMUX-}" in
  /*,*,*) socket=${TMUX%%,*} ;;
  *) printf '%s\n' 'tmux-oil: TMUX must identify the invoking tmux socket' >&2; exit 1 ;;
esac

TMUX_OIL_TMUX_BIN=$(command -v tmux) || { printf '%s\n' 'tmux-oil: tmux not found' >&2; exit 1; }
TMUX_OIL_NVIM_BIN=$(command -v nvim) || { printf '%s\n' 'tmux-oil: nvim not found' >&2; exit 1; }
TMUX_OIL_SOCKET=$socket
if "$TMUX_OIL_TMUX_BIN" -S "$TMUX_OIL_SOCKET" list-commands move-session >/dev/null 2>&1; then
  TMUX_OIL_PERSISTENT_ORDER=1
else
  TMUX_OIL_PERSISTENT_ORDER=0
fi
export TMUX_OIL_TMUX_BIN TMUX_OIL_SOCKET TMUX_OIL_PERSISTENT_ORDER

TMUX_OIL_INIT=$(awk '
  /^# __TMUX_OIL_LUA_BEGIN__$/ { emit=1; next }
  /^# __TMUX_OIL_LUA_END__$/ { exit }
  emit
' "$0")
export TMUX_OIL_INIT

: <<'TMUX_OIL_LUA'
# __TMUX_OIL_LUA_BEGIN__
local M = {}
_G.tmux_oil = M
vim.g.tmux_oil_init_loaded = true

local tmux_bin = assert(vim.env.TMUX_OIL_TMUX_BIN, "missing tmux executable")
local socket = assert(vim.env.TMUX_OIL_SOCKET, "missing tmux socket")
local persistent_order = vim.env.TMUX_OIL_PERSISTENT_ORDER == "1"
M.persistent_order = persistent_order

local function fail(message)
  error("tmux-oil: " .. message, 0)
end

local function validate_name(name)
  if type(name) ~= "string" or name == "" then
    fail("session names must be nonempty strings")
  end
  if name:find(":", 1, true) or name:find(".", 1, true) then
    fail("session names may not contain ':' or '.'")
  end
  for i = 1, #name do
    local byte = name:byte(i)
    if byte < 32 or byte == 127 then
      fail("session names may not contain ASCII control characters")
    end
  end
  return name
end
M.validate_name = validate_name

local function decode_json_string(text)
  if #text < 2 or text:byte(1) ~= 34 or text:byte(#text) ~= 34 then
    fail("name field must be exactly one JSON string")
  end
  local i = 2
  while i < #text do
    local byte = text:byte(i)
    if byte == 34 then
      fail("unexpected text after JSON string")
    elseif byte == 92 then
      i = i + 1
      local escape = text:sub(i, i)
      if escape == "u" then
        local hex = text:sub(i + 1, i + 4)
        if #hex ~= 4 or not hex:match("^[0-9a-fA-F]+$") then
          fail("invalid JSON unicode escape")
        end
        i = i + 4
      elseif not escape:match('^["\\/bfnrt]$') then
        fail("invalid JSON escape")
      end
    elseif byte < 32 then
      fail("unescaped control character in JSON string")
    end
    i = i + 1
  end
  local ok, value = pcall(vim.json.decode, text)
  if not ok or type(value) ~= "string" then
    fail("invalid JSON string")
  end
  return validate_name(value)
end

local function split_row(line, source)
  local tab = line:find("\t", 1, true)
  if not tab or line:find("\t", tab + 1, true) then
    fail(source .. " row must contain exactly two TAB-separated fields")
  end
  return line:sub(1, tab - 1), line:sub(tab + 1)
end

local function model(rows)
  if rows[1] and rows[1].rank then
    table.sort(rows, function(a, b)
      if a.rank ~= b.rank then return a.rank < b.rank end
      return tonumber(a.id:sub(2)) < tonumber(b.id:sub(2))
    end)
  end
  local result = {
    order = {}, server_order = {}, by_id = {}, parent_by_id = {},
    parent_option_by_id = {}, tree_prefix_by_id = {},
  }
  local raw_order, raw_parent = {}, {}
  for _, row in ipairs(rows) do
    if result.by_id[row.id] then fail("duplicate session ID " .. row.id) end
    raw_order[#raw_order + 1] = row.id
    result.by_id[row.id] = row.name
    result.parent_option_by_id[row.id] = row.parent
    raw_parent[row.id] = row.parent
  end
  result.server_order = raw_order
  local children, roots = {}, {}
  for _, id in ipairs(raw_order) do
    local parent = raw_parent[id]
    if parent and result.by_id[parent] and parent ~= id then
      local seen = { [id] = true }
      local ancestor = parent
      while ancestor and not seen[ancestor] do
        seen[ancestor] = true
        ancestor = raw_parent[ancestor]
      end
      if not ancestor then
        result.parent_by_id[id] = parent
        children[parent] = children[parent] or {}
        children[parent][#children[parent] + 1] = id
      else
        roots[#roots + 1] = id
      end
    else
      roots[#roots + 1] = id
    end
  end
  local function append(id, display_prefix, child_prefix)
    result.order[#result.order + 1] = id
    result.tree_prefix_by_id[id] = display_prefix
    local descendants = children[id] or {}
    for index, child in ipairs(descendants) do
      local last = index == #descendants
      append(child, child_prefix .. (last and " └── " or " ├── "),
        child_prefix .. (last and "     " or " │   "))
    end
  end
  for _, id in ipairs(roots) do append(id, "", "") end
  return result
end

function M.parse_snapshot(output)
  if output:sub(-1) == "\n" then output = output:sub(1, -2) end
  if output == "" then return model({}) end
  local rows = {}
  for _, line in ipairs(vim.split(output, "\n", { plain = true })) do
    local rank, id, name, parent = line:match("^(%d+)\t([^\t]+)\t([^\t]*)\t([^\t]*)$")
    if not rank then rank, id, name = line:match("^(%d+)\t([^\t]+)\t(.*)$") end
    if not rank then id, name = split_row(line, "snapshot") end
    if not id:match("^%$%d+$") then fail("invalid snapshot session ID " .. id) end
    rows[#rows + 1] = {
      id = id, name = validate_name(name), rank = tonumber(rank),
      parent = parent and parent:match("^%$%d+$") and parent or nil,
    }
  end
  return model(rows)
end

function M.argv(tail)
  local argv = { tmux_bin, "-S", socket }
  vim.list_extend(argv, tail)
  return argv
end

function M.tmux(tail)
  local result = vim.system(M.argv(tail), { text = true }):wait()
  if result.code ~= 0 then
    fail((result.stderr or "tmux command failed"):gsub("%s+$", ""))
  end
  return result.stdout or ""
end

function M.snapshot()
  local rank = persistent_order and "#{session_order}" or "#{session_created}"
  return M.parse_snapshot(M.tmux({
    "list-sessions", "-F", rank
      .. "\t#{session_id}\t#{session_name}\t#{@pi_subagent_parent_id}",
  }))
end

function M.render(state)
  local lines = {}
  for _, id in ipairs(state.order) do
    lines[#lines + 1] = id .. "\t" .. vim.json.encode(state.by_id[id])
  end
  return table.concat(lines, "\n")
end

function M.parse_manifest(text, baseline)
  if text:sub(-1) == "\n" then
    text = text:sub(1, -2)
  end
  local intent = { order = {}, existing = {}, new = {} }
  local names = {}
  if text == "" then
    return intent
  end
  for _, line in ipairs(vim.split(text, "\n", { plain = true })) do
    local marker, encoded_name = split_row(line, "manifest")
    local name = decode_json_string(encoded_name)
    if names[name] then
      fail("duplicate resulting session name " .. name)
    end
    names[name] = true
    if marker == "+" then
      intent.new[#intent.new + 1] = name
      intent.order[#intent.order + 1] = { marker = marker, name = name }
    elseif marker:match("^%$%d+$") then
      if baseline.by_id[marker] == nil then
        fail("unknown or forged session ID " .. marker)
      end
      if intent.existing[marker] ~= nil then
        fail("duplicate session ID " .. marker)
      end
      intent.existing[marker] = name
      intent.order[#intent.order + 1] = { marker = marker, name = name }
    else
      fail("invalid new-row marker or unsupported field " .. marker)
    end
  end
  return intent
end

local function sorted_ids(state)
  local ids = vim.tbl_keys(state.by_id)
  table.sort(ids, function(a, b)
    return tonumber(a:sub(2)) < tonumber(b:sub(2))
  end)
  return ids
end

function M.structural_drift(baseline, current)
  if vim.tbl_count(baseline.by_id) ~= vim.tbl_count(current.by_id) then return true end
  for id, name in pairs(baseline.by_id) do
    if current.by_id[id] ~= name
        or (current.parent_option_by_id or {})[id]
          ~= (baseline.parent_option_by_id or {})[id] then
      return true
    end
  end
  local baseline_order = baseline.server_order or baseline.order
  local current_order = current.server_order or current.order
  return persistent_order and not vim.deep_equal(baseline_order, current_order)
end

function M.jump_argv(id, baseline)
  if baseline.by_id[id] == nil then
    fail("cannot jump to unknown session ID " .. id)
  end
  return M.argv({ "switch-client", "-t", id })
end

local function copy_state(state)
  return {
    order = vim.deepcopy(state.order),
    server_order = vim.deepcopy(state.server_order or state.order),
    by_id = vim.deepcopy(state.by_id),
    parent_by_id = vim.deepcopy(state.parent_by_id or {}),
    parent_option_by_id = vim.deepcopy(state.parent_option_by_id or {}),
    tree_prefix_by_id = vim.deepcopy(state.tree_prefix_by_id or {}),
  }
end

local function relative_order(order, keep)
  local result = {}
  for _, id in ipairs(order or {}) do
    if keep[id] then result[#result + 1] = id end
  end
  return result
end

local function order_position(order, id)
  for index, value in ipairs(order or {}) do
    if value == id then return index end
  end
end

local function insert_extras(result, source, extras)
  local present = {}
  for _, token in ipairs(result) do present[token] = true end
  for index, token in ipairs(source or {}) do
    if extras[token] then
      local before
      for next_index = index + 1, #(source or {}) do
        local candidate = source[next_index]
        if present[candidate] then before = candidate; break end
      end
      if before then
        table.insert(result, order_position(result, before), token)
      else
        local after
        for previous = index - 1, 1, -1 do
          local candidate = source[previous]
          if present[candidate] then after = candidate; break end
        end
        if after then
          table.insert(result, order_position(result, after) + 1, token)
        else
          result[#result + 1] = token
        end
      end
      present[token] = true
    end
  end
end

local function format_conflicts(conflicts)
  return table.concat(conflicts, "\n")
end

function M.describe_difference(baseline, current)
  local differences = {}
  for _, id in ipairs(sorted_ids(baseline)) do
    if current.by_id[id] == nil then
      differences[#differences + 1] = id .. " missing (name)"
    elseif baseline.by_id[id] ~= current.by_id[id] then
      differences[#differences + 1] = id .. " name "
        .. vim.json.encode(baseline.by_id[id]) .. " -> " .. vim.json.encode(current.by_id[id])
    end
    local before_parent = (baseline.parent_option_by_id or {})[id]
    local after_parent = (current.parent_option_by_id or {})[id]
    if before_parent ~= after_parent then
      differences[#differences + 1] = id .. " parent "
        .. vim.json.encode(before_parent) .. " -> " .. vim.json.encode(after_parent)
    end
  end
  for _, id in ipairs(sorted_ids(current)) do
    if baseline.by_id[id] == nil then
      differences[#differences + 1] = id .. " added name " .. vim.json.encode(current.by_id[id])
    end
  end
  local common = {}
  for id in pairs(baseline.by_id) do
    if current.by_id[id] then common[id] = true end
  end
  local before_order = relative_order(baseline.server_order or baseline.order, common)
  local after_order = relative_order(current.server_order or current.order, common)
  if not vim.deep_equal(before_order, after_order) then
    differences[#differences + 1] = "order " .. table.concat(before_order, ",")
      .. " -> " .. table.concat(after_order, ",")
  end
  if #differences == 0 then return "metadata unchanged" end
  return table.concat(differences, "; ")
end

function M.reconcile(baseline, intent, current)
  local conflicts, existing, names = {}, {}, {}
  local survivor = {}
  for id, desired in pairs(intent.existing) do
    local baseline_name = baseline.by_id[id]
    local live_name = current.by_id[id]
    if live_name == nil then
      if desired ~= baseline_name then
        conflicts[#conflicts + 1] = string.format(
          "conflict %s name: edited target was deleted live", id)
      end
    else
      survivor[id] = true
      if desired == baseline_name then
        existing[id] = live_name
      elseif live_name == baseline_name or live_name == desired then
        existing[id] = desired
      else
        conflicts[#conflicts + 1] = string.format(
          "conflict %s name: local %s vs live %s",
          id, vim.json.encode(desired), vim.json.encode(live_name))
        existing[id] = desired
      end
    end
  end
  for id, baseline_name in pairs(baseline.by_id) do
    if intent.existing[id] == nil and current.by_id[id] ~= nil then
      local live_parent = (current.parent_option_by_id or {})[id]
      local baseline_parent = (baseline.parent_option_by_id or {})[id]
      if current.by_id[id] ~= baseline_name then
        conflicts[#conflicts + 1] = string.format(
          "conflict %s name: local deletion vs live rename to %s",
          id, vim.json.encode(current.by_id[id]))
      elseif live_parent ~= baseline_parent then
        conflicts[#conflicts + 1] = string.format(
          "conflict %s parent: local deletion vs live reparent",
          id)
      else
        -- The deletion is still local and is planned below.
      end
      if current.by_id[id] == baseline_name and live_parent == baseline_parent then
        survivor[id] = true
      end
    end
  end
  if #conflicts > 0 then
    return nil, format_conflicts(conflicts)
  end

  for id, name in pairs(existing) do names[name] = id end
  for id, name in pairs(current.by_id) do
    if baseline.by_id[id] == nil then
      if names[name] then
        return nil, string.format("conflict %s name: live addition duplicates %s", id,
          names[name])
      end
      names[name] = id
      existing[id] = name
      survivor[id] = true
    end
  end
  for _, name in ipairs(intent.new) do
    if names[name] then
      return nil, string.format("conflict new session name: %s is already live as %s",
        vim.json.encode(name), names[name])
    end
    names[name] = true
  end

  local common = {}
  for id in pairs(baseline.by_id) do
    if survivor[id] and intent.existing[id] ~= nil and current.by_id[id] ~= nil then
      common[id] = true
    end
  end
  local baseline_display = relative_order(baseline.order, common)
  local local_rows = intent.display_order or intent.order
  local local_all = {}
  for _, row in ipairs(local_rows) do
    if row.marker ~= "+" then local_all[#local_all + 1] = row.marker end
  end
  local local_display = relative_order(local_all, common)
  -- This is the raw execution target induced by the user's display reorder.
  local local_raw_target = vim.deepcopy(local_display)
  local baseline_raw = relative_order(baseline.server_order or baseline.order, common)
  local live_raw = relative_order(current.server_order or current.order, common)
  local local_changed = not vim.deep_equal(baseline_display, local_display)
  local live_changed = not vim.deep_equal(baseline_raw, live_raw)
  local missing_local, local_set = {}, {}
  for _, id in ipairs(local_all) do
    local_set[id] = true
    if current.by_id[id] == nil then missing_local[id] = true end
  end
  if next(missing_local) and not vim.deep_equal(
      relative_order(baseline.order, local_set), local_all) then
    return nil, "conflict order: locally reordered deleted session "
      .. table.concat(relative_order(local_all, missing_local), ",")
  end
  -- A local display reorder is the raw target we intend to execute. External
  -- ordering is detected only from raw server order, never from tree display.
  if local_changed and live_changed and not vim.deep_equal(local_raw_target, live_raw) then
    return nil, "conflict order: concurrent reorder of " .. table.concat(local_raw_target, ",")
  end

  local core = local_changed and local_raw_target or live_raw
  local result_order = vim.deepcopy(core)
  local live_extras, local_extras = {}, {}
  for id in pairs(existing) do
    if baseline.by_id[id] == nil then live_extras[id] = true end
  end
  for _, row in ipairs(local_rows) do
    if row.marker == "+" then local_extras[row.name] = true end
  end
  local source_live = current.server_order or current.order
  insert_extras(result_order, source_live, live_extras)
  local source_local = {}
  for _, row in ipairs(local_rows) do
    source_local[#source_local + 1] = row.marker == "+" and row.name or row.marker
  end
  insert_extras(result_order, source_local, local_extras)

  -- Keep the execution target raw, but refresh the buffer in tree display order.
  local display_core = local_changed and local_display
    or relative_order(current.order, common)
  local display_order = vim.deepcopy(display_core)
  insert_extras(display_order, current.order, live_extras)
  insert_extras(display_order, source_local, local_extras)

  local function rows_for(order)
    local rows = {}
    for _, token in ipairs(order) do
      if existing[token] then
        rows[#rows + 1] = { marker = token, name = existing[token] }
      else
        rows[#rows + 1] = { marker = "+", name = token }
      end
    end
    return rows
  end
  return {
    order = rows_for(result_order), display_order = rows_for(display_order),
    existing = vim.deepcopy(existing), new = vim.deepcopy(intent.new),
  }
end

function M.plan(baseline, intent, current)
  if M.structural_drift(baseline, current) then
    fail("structural drift detected")
  end
  local plan = { renames = {}, creates = {}, kills = {}, operations = {} }
  for _, id in ipairs(sorted_ids(baseline)) do
    local wanted = intent.existing[id]
    if wanted == nil then
      plan.kills[#plan.kills + 1] = {
        kind = "kill", id = id,
        argv = M.argv({ "kill-session", "-t", id }),
      }
    elseif wanted ~= baseline.by_id[id] then
      plan.renames[#plan.renames + 1] = {
        kind = "rename", id = id, name = wanted,
        argv = M.argv({ "rename-session", "-t", id, "--", wanted }),
      }
    end
  end
  local creates = vim.deepcopy(intent.new)
  table.sort(creates)
  for _, name in ipairs(creates) do
    plan.creates[#plan.creates + 1] = {
      kind = "create", name = name,
      argv = M.argv({ "new-session", "-d", "-s", name }),
    }
  end
  vim.list_extend(plan.operations, plan.renames)
  vim.list_extend(plan.operations, plan.creates)
  vim.list_extend(plan.operations, plan.kills)
  return plan
end

local function remove_id(state, id)
  state.by_id[id], state.parent_by_id[id], state.parent_option_by_id[id],
    state.tree_prefix_by_id[id] = nil, nil, nil, nil
  for child, parent in pairs(state.parent_by_id) do
    if parent == id then state.parent_by_id[child] = nil end
  end
  for index, value in ipairs(state.order) do
    if value == id then
      table.remove(state.order, index)
      break
    end
  end
  for index, value in ipairs(state.server_order or {}) do
    if value == id then
      table.remove(state.server_order, index)
      return
    end
  end
end

local function intended_order_changed(baseline, intent)
  local before, after = {}, {}
  for _, id in ipairs(baseline.order) do
    if intent.existing[id] ~= nil then before[#before + 1] = id end
  end
  for _, row in ipairs(intent.order) do
    if row.marker ~= "+" then after[#after + 1] = row.marker end
  end
  return not vim.deep_equal(before, after)
end

local function desired_order(intent, state)
  local ids = {}
  for _, row in ipairs(intent.order) do
    if row.marker ~= "+" then
      ids[#ids + 1] = row.marker
    else
      local found
      for id, name in pairs(state.by_id) do
        if name == row.name then found = id; break end
      end
      if not found then fail("created session has no stable ID: " .. row.name) end
      ids[#ids + 1] = found
    end
  end
  return ids
end

local function adjacent(state, id, target)
  local order = state.server_order or state.order
  for index, value in ipairs(order) do
    if value == id then return order[index + 1] == target end
  end
  return false
end

local function move_in(order, id, target)
  local source_index, target_index
  for index, value in ipairs(order) do
    if value == id then source_index = index end
    if value == target then target_index = index end
  end
  if not source_index or not target_index then fail("cannot reorder missing stable session ID") end
  table.remove(order, source_index)
  if source_index < target_index then target_index = target_index - 1 end
  table.insert(order, target_index, id)
end

local function move_before(state, id, target)
  move_in(state.server_order or state.order, id, target)
  if state.server_order and state.order then move_in(state.order, id, target) end
end

local function execution_plan(plan, current)
  local operations = {}
  local simulated = copy_state(current)
  for _, operation in ipairs(plan.kills) do
    operations[#operations + 1] = operation
    remove_id(simulated, operation.id)
  end

  local pending = {}
  for _, operation in ipairs(plan.renames) do
    pending[operation.id] = operation.name
  end
  local occupied, reserved = {}, {}
  for id, name in pairs(simulated.by_id) do occupied[name] = id end
  for _, operation in ipairs(plan.renames) do reserved[operation.name] = true end
  for _, operation in ipairs(plan.creates) do reserved[operation.name] = true end
  local temporary_index = 0
  while next(pending) do
    local ids = vim.tbl_keys(pending)
    table.sort(ids, function(a, b)
      return tonumber(a:sub(2)) < tonumber(b:sub(2))
    end)
    local chosen
    for _, id in ipairs(ids) do
      if occupied[pending[id]] == nil then
        chosen = id
        break
      end
    end
    if chosen then
      local name = pending[chosen]
      operations[#operations + 1] = {
        kind = "rename", id = chosen, name = name,
        argv = M.argv({ "rename-session", "-t", chosen, "--", name }),
      }
      occupied[simulated.by_id[chosen]] = nil
      occupied[name] = chosen
      simulated.by_id[chosen] = name
      pending[chosen] = nil
    else
      chosen = ids[1]
      local temporary
      repeat
        temporary_index = temporary_index + 1
        temporary = "tmux-oil-tmp-" .. chosen:sub(2) .. "-" .. temporary_index
      until occupied[temporary] == nil and reserved[temporary] == nil
      operations[#operations + 1] = {
        kind = "rename", id = chosen, name = temporary, temporary = true,
        argv = M.argv({ "rename-session", "-t", chosen, "--", temporary }),
      }
      occupied[simulated.by_id[chosen]] = nil
      occupied[temporary] = chosen
      simulated.by_id[chosen] = temporary
    end
  end

  vim.list_extend(operations, plan.creates)
  return operations
end

local function current_session_id()
  local id = M.tmux({ "display-message", "-p", "#{session_id}" }):gsub("%s+$", "")
  if not id:match("^%$%d+$") then
    fail("cannot resolve the invoking/current session safely")
  end
  return id
end
M.current_session_id = current_session_id

local function report_error(message, report, failed_index)
  report.error = message
  report.acknowledged = report.acknowledged or copy_state(report.before)
  for index = failed_index + 1, #report.operations do
    report.not_run[#report.not_run + 1] = report.operations[index].argv
  end
  report.completed = #report.succeeded
  report.pending = #report.not_run
  M.last_apply_report = report
  local lines = { message, "succeeded argv:" }
  if #report.succeeded == 0 then
    lines[#lines + 1] = "  (none)"
  else
    for _, argv in ipairs(report.succeeded) do
      lines[#lines + 1] = "  " .. vim.json.encode(argv)
    end
  end
  if report.failed then
    lines[#lines + 1] = "failed argv:"
    lines[#lines + 1] = "  " .. vim.json.encode(report.failed)
  end
  lines[#lines + 1] = "never-ran argv:"
  if #report.not_run == 0 then
    lines[#lines + 1] = "  (none)"
  else
    for _, argv in ipairs(report.not_run) do
      lines[#lines + 1] = "  " .. vim.json.encode(argv)
    end
  end
  lines[#lines + 1] = "no rollback was attempted"
  fail(table.concat(lines, "\n"))
end

function M.apply(baseline, intent)
  M.last_apply_report = nil
  local fresh = M.snapshot()
  local ok, planned = pcall(M.plan, baseline, intent, fresh)
  if not ok then
    M.last_apply_report = {
      before = fresh, current = fresh, acknowledged = copy_state(fresh),
      operations = {}, succeeded = {}, not_run = {}, attempted = {}, error = tostring(planned),
      completed = 0, pending = 0,
    }
    fail(tostring(planned))
  end
  if #planned.kills == #fresh.order and #planned.kills > 0 then
    M.last_apply_report = {
      before = fresh, current = fresh, acknowledged = copy_state(fresh),
      operations = {}, succeeded = {}, not_run = {}, attempted = {}, completed = 0, pending = 0,
    }
    fail("refusing to kill the last session/server because completion cannot be reported safely")
  end
  if #planned.kills > 0 then
    local current = current_session_id()
    local killing = {}
    for _, operation in ipairs(planned.kills) do
      killing[operation.id] = true
    end
    for _, operation in ipairs(planned.kills) do
      if operation.id == current then
        local survivor = nil
        for _, id in ipairs(fresh.order) do
          if killing[id] == nil then survivor = id; break end
        end
        if survivor == nil then
          M.last_apply_report = {
            before = fresh, current = fresh, acknowledged = copy_state(fresh),
            operations = {}, succeeded = {}, not_run = {}, attempted = {}, completed = 0, pending = 0,
          }
          fail("refusing to kill the last session/server because completion cannot be reported safely")
        end
        -- Deleting the session the user is in must not tear down the popup:
        -- move the invoking client to a surviving session first so the ts
        -- menu stays open while the kill lands.
        M.tmux({ "switch-client", "-t", survivor })
      end
    end
  end

  local operations = execution_plan(planned, fresh)
  local expected = copy_state(fresh)
  local report = {
    before = fresh, operations = operations, succeeded = {}, not_run = {}, attempted = {},
    created_ids = {}, acknowledged = copy_state(fresh), completed = 0, pending = 0,
  }
  local function execute(operation, index)
    local live = M.snapshot()
    report.current = live
    report.acknowledged = copy_state(expected)
    if M.structural_drift(expected, live) then
      report_error("structural drift detected before operation " .. index, report, index - 1)
    end
    if operation.id and live.by_id[operation.id] ~= expected.by_id[operation.id] then
      report_error("stable session target disappeared before operation " .. index, report, index - 1)
    end
    if operation.target and live.by_id[operation.target] ~= expected.by_id[operation.target] then
      report_error("stable session target disappeared before operation " .. index, report, index - 1)
    end
    if operation.kind == "kill" and current_session_id() == operation.id then
      report_error("refusing to kill the invoking/current session before operation "
        .. index, report, index - 1)
    end
    if M.test_before_command then M.test_before_command(index, operation, live) end

    report.attempted[#report.attempted + 1] = operation.argv
    local result = vim.system(operation.argv, { text = true }):wait()
    if result.code ~= 0 then
      report.failed = operation.argv
      report_error("tmux error at operation " .. index .. ": "
        .. (result.stderr or "command failed"):gsub("%s+$", ""), report, index)
    end
    report.succeeded[#report.succeeded + 1] = operation.argv

    if operation.kind == "kill" then
      remove_id(expected, operation.id)
    elseif operation.kind == "rename" then
      expected.by_id[operation.id] = operation.name
    elseif operation.kind == "move" then
      move_before(expected, operation.id, operation.target)
    elseif operation.kind == "create" then
      local after_create = M.snapshot()
      local created_id
      for id, name in pairs(after_create.by_id) do
        if expected.by_id[id] == nil and name == operation.name then
          if created_id then
            report_error("ambiguous created session after operation " .. index, report, index)
          end
          created_id = id
        end
      end
      if not created_id or #after_create.order ~= #expected.order + 1 then
        report_error("created session could not be resolved by fresh stable ID after operation "
          .. index, report, index)
      end
      expected.order[#expected.order + 1] = created_id
      expected.server_order[#expected.server_order + 1] = created_id
      expected.by_id[created_id] = operation.name
      report.created_ids[operation.name] = created_id
      report.current = after_create
      if M.structural_drift(expected, after_create) then
        report_error("structural drift detected after create operation " .. index, report, index)
      end
    end
    report.acknowledged = copy_state(expected)
    report.completed = #report.succeeded
  end

  for index, operation in ipairs(operations) do execute(operation, index) end

  if persistent_order then
    local wanted = desired_order(intent, expected)
    local first_move = #operations + 1
    local simulated = copy_state(expected)
    for index = #wanted - 1, 1, -1 do
      local id, target = wanted[index], wanted[index + 1]
      if not adjacent(simulated, id, target) then
        operations[#operations + 1] = {
          kind = "move", id = id, target = target,
          argv = M.argv({ "move-session", "-b", "-s", id, "-t", target }),
        }
        move_before(simulated, id, target)
      end
    end
    for index = first_move, #operations do execute(operations[index], index) end
  elseif intended_order_changed(baseline, intent) then
    report.warning = "server lacks move-session; row reordering was not persisted; "
      .. "restart with the patched tmux binary to enable persistent ordering"
  end

  local after = M.snapshot()
  report.current = after
  if M.structural_drift(expected, after) then
    report.acknowledged = copy_state(expected)
    report_error("structural drift detected after apply", report, #operations)
  end
  report.after = after
  report.acknowledged = copy_state(expected)
  report.completed = #report.succeeded
  report.pending = #report.not_run
  M.last_apply_report = report
  return report
end

local function parse_live(output)
  if output:sub(-1) == "\n" then output = output:sub(1, -2) end
  if output == "" then return model({}), {} end
  local rows, metadata = {}, {}
  for _, line in ipairs(vim.split(output, "\n", { plain = true })) do
    local rank, id, name, status, parent = line:match(
      "^(%d+)\t([^\t]+)\t([^\t]*)\t([^\t]*)\t([^\t]*)$")
    if not id or not id:match("^%$%d+$") then fail("invalid live metadata row") end
    validate_name(name)
    rows[#rows + 1] = {
      rank = tonumber(rank), id = id, name = name,
      parent = parent:match("^%$%d+$") and parent or nil,
    }
    metadata[id] = status
  end
  return model(rows), metadata
end

local function annotation_text(details)
  local parts = {}
  for _, chunk in ipairs(details.virt_text or {}) do parts[#parts + 1] = chunk[1] end
  for _, virtual_line in ipairs(details.virt_lines or {}) do
    for _, chunk in ipairs(virtual_line) do parts[#parts + 1] = chunk[1] end
  end
  return table.concat(parts)
end
M.annotation_text = annotation_text

local style_groups = {
  green = "TmuxOilGreen",
  yellow = "TmuxOilYellow",
  red = "TmuxOilRed",
}

local function styled_chunks(text)
  local chunks, group, offset = {}, "TmuxOilMeta", 1
  while offset <= #text do
    local first, last, style = text:find("#%[([^%]]*)%]", offset)
    local plain = text:sub(offset, first and first - 1 or #text)
    if plain ~= "" then chunks[#chunks + 1] = { plain, group } end
    if not first then break end
    if style == "default" then
      group = "TmuxOilMeta"
    else
      group = style_groups[style:match("fg=([^,]+)")] or group
    end
    offset = last + 1
  end
  return chunks
end
M.styled_chunks = styled_chunks

local function status_fields(text)
  local fields = vim.split(text, "|", { plain = true })
  if #fields ~= 4 then return nil end
  return fields
end

local function aligned_status(text, widths)
  local fields = status_fields(text)
  if not fields then return text end
  for index = 1, 3 do
    local plain = fields[index]:gsub("#%[[^%]]*%]", "")
    fields[index] = fields[index]
      .. string.rep(" ", math.max(0, widths[index] - vim.fn.strdisplaywidth(plain)))
  end
  return table.concat(fields, "|")
end
M.aligned_status = aligned_status

-- Private row tokens, never buffer syntax. Text edits rename; linewise cuts/puts
-- transport tokens; copies of a live token create a new session. History is keyed
-- by undo branch sequence, NOT final text (rename swaps and moves can look alike).
local identity
local function undo_parent(seq, entries, parent)
  for _, entry in ipairs(entries) do
    if entry.seq == seq then return parent end
    if entry.alt then
      local found = undo_parent(seq, entry.alt, parent)
      if found ~= nil then return found end
    end
    parent = entry.seq
  end
end

local function new_identity(buf, rows)
  -- ponytail: full snapshots/anchors suit a small session list; prune and update
  -- incrementally only if large lists or long-lived editors make this costly.
  local a, f = vim.api, vim.fn
  local I = { history = {}, bindings = {}, registers = {}, next_token = 0,
    ns = a.nvim_create_namespace("tmux-oil-identity"), buf = buf }
  local function text() return a.nvim_buf_get_lines(buf, 0, -1, false) end
  local function token(id)
    I.next_token = I.next_token + 1
    I.bindings[I.next_token] = id
    return I.next_token
  end
  local function anchors(s)
    a.nvim_buf_clear_namespace(buf, I.ns, 0, -1)
    I.marks = {}
    for row, t in ipairs(s.tokens) do
      I.marks[t] = a.nvim_buf_set_extmark(buf, I.ns, row - 1, #s.lines[row], {
        end_row = row, end_col = 0, strict = false, right_gravity = true,
        end_right_gravity = false, invalidate = true, undo_restore = true,
      })
    end
  end
  local function settle_move(s)
    if not s.move then return end
    local before, tokens, seen = s.move, {}, {}
    -- Only native move-region transports every newline anchor intact. Filters,
    -- sort and API replacements collapse/invalidate these anchors instead.
    for row, t in ipairs(before.tokens) do
      local mark = I.marks[t]
        and a.nvim_buf_get_extmark_by_id(buf, I.ns, I.marks[t], { details = true }) or {}
      local dest = mark[1] and mark[1] + 1
      if not dest or mark[3].invalid or dest > #s.lines or seen[dest]
          or before.lines[row] ~= s.lines[dest] then
        s.bad = "ambiguous whole-row transformation; undo it or :TmuxOilAcceptLive"
        s.move = nil
        return
      end
      seen[dest], tokens[dest] = true, t
    end
    if #tokens ~= #s.lines or vim.deep_equal(tokens, before.tokens) then
      s.bad = "ambiguous whole-row transformation; undo it or :TmuxOilAcceptLive"
    else
      s.tokens = tokens
    end
    s.move = nil
  end
  function I.current()
    if I.fault then fail(I.fault) end
    local s = I.history[f.undotree().seq_cur]
    if not s or not vim.deep_equal(s.lines, text()) then
      fail("identity history unavailable; undo to a known state or :TmuxOilAcceptLive")
    end
    settle_move(s)
    anchors(s)
    return s
  end
  function I.checked()
    local s = I.current()
    if s.bad then fail(s.bad) end
    if #s.tokens ~= #s.lines then fail("identity row count mismatch; undo the edit") end
    local seen = {}
    for _, t in ipairs(s.tokens) do
      if seen[t] then fail("ambiguous duplicate row identity; undo the put") end
      seen[t] = true
    end
    return s
  end
  function I.ids()
    local s, ids = I.checked(), {}
    for row, t in ipairs(s.tokens) do ids[row] = I.bindings[t] or "+" end
    return ids
  end
  local function guarded(callback)
    return function(...)
      if I.suspended then return end
      local ok, err = pcall(callback, ...)
      if not ok then I.fault = "identity observer failed: " .. tostring(err) end
    end
  end
  local root_first
  function I.replace(new_rows, initial)
    local s = { lines = {}, tokens = {} }
    local by_id = {}
    for t, id in pairs(I.bindings) do by_id[id] = t end
    for _, row in ipairs(new_rows) do
      s.lines[#s.lines + 1] = row.name
      s.tokens[#s.tokens + 1] = by_id[row.marker] or token(row.marker ~= "+" and row.marker or nil)
    end
    if #s.lines == 0 then s.lines, s.tokens = { "" }, { token() } end
    if not initial then
      local ok, old = pcall(I.current)
      if ok and not old.bad and vim.deep_equal(old.lines, s.lines)
          and vim.deep_equal(old.tokens, s.tokens) then return end
    end
    I.suspended = true
    a.nvim_buf_set_lines(buf, 0, -1, false, s.lines)
    I.suspended = false
    local seq = f.undotree().seq_cur
    if I.fault then
      -- Accept-live after lost/imported history establishes a new known anchor;
      -- old Neovim text undo remains usable, but has no trusted row snapshots.
      I.history, I.root, root_first = {}, seq, nil
    end
    I.history[seq] = s
    if I.root and seq == I.root + 1 then root_first = seq end
    I.fault, I.put, I.bytes = nil, nil, nil
    anchors(s)
  end
  I.replace(rows, true)
  I.root = f.undotree().seq_cur
  a.nvim_buf_attach(buf, false, {
    on_bytes = guarded(function(_, _, _, _, _, _, oldrow, _, _, newrow)
      if f.undotree().synced == 1 then I.bytes = nil; return end
      I.bytes = I.bytes or oldrow > 0 or newrow > 0
    end),
    on_lines = guarded(function(_, _, _, first, last, newlast)
      local tree = f.undotree()
      -- 0.12 undo notifications carry the OLD seq_cur, including changedtick.
      -- Forward edits are unsynced; restore traversal state only after it settles.
      if tree.synced == 1 then I.bytes = nil; return end
      local parent = undo_parent(tree.seq_cur, tree.entries, -1)
      if parent == -1 then
        if not root_first and tree.seq_cur == I.root + 1 then root_first = tree.seq_cur end
        if root_first and undo_parent(root_first, tree.entries, -1) == -1 then parent = I.root end
      end
      local base = I.history[tree.seq_cur] or I.history[parent]
      if not base then error("missing undo ancestry (history was replaced/pruned)") end
      local s, now = vim.deepcopy(base), text()
      local oldcount, newcount = last - first, newlast - first
      local inserted = {}
      if f.eval('&undolevels') < 1 then s.bad = "identity needs undo history; restore undolevels and accept live" end
      if oldcount == newcount and not I.bytes then
        for i = first + 1, last do inserted[#inserted + 1] = s.tokens[i] end
      elseif newcount == 0 then
        -- A removed line is deletion; an emptied line above retains its token.
      elseif oldcount == 0 and I.put then
        local put, live = I.put, {}
        for _, t in ipairs(s.tokens) do live[t] = true end
        if newcount % #put.contents ~= 0 then s.bad = "ambiguous put size; undo it" end
        for i = 1, newcount do
          if now[first + i] ~= put.contents[(i - 1) % #put.contents + 1] then
            s.bad = "ambiguous put contents; undo it"
          end
          local source = put.tokens and put.tokens[(i - 1) % #put.tokens + 1]
          if not source and not put.new then
            s.bad = "ambiguous linewise put: register has no row provenance; undo it"
          end
          local t = source and not live[source] and source or token()
          inserted[i], live[t] = t, true
        end
        I.put = nil
      elseif oldcount == 0 and newcount == 1 and now[first + 1] == "" then
        inserted[1] = token()
      else
        -- Keep an unresolved transaction until native move-region has adjusted
        -- extmarks. Never infer its permutation from names alone.
        s.move = s.move or vim.deepcopy(base)
        for _ = 1, newcount do inserted[#inserted + 1] = token() end
      end
      local tokens = {}
      for i = 1, first do tokens[#tokens + 1] = s.tokens[i] end
      vim.list_extend(tokens, inserted)
      for i = last + 1, #s.tokens do tokens[#tokens + 1] = s.tokens[i] end
      if #tokens == 0 and #now == 1 and now[1] == "" then tokens = { token() } end
      s.lines, s.tokens = now, tokens
      I.history[tree.seq_cur] = s
      I.bytes = nil
    end),
    on_reload = function() I.fault = "identity history reloaded; :TmuxOilAcceptLive required" end,
  })
  local group = a.nvim_create_augroup("tmux_oil_identity", { clear = true })
  a.nvim_create_autocmd("TextYankPost", { group = group, callback = guarded(function()
    local e = vim.v.event
    local reg = e.regname ~= "" and e.regname or '"'
    local info = f.getreginfo(reg)
    local capture = { contents = vim.deepcopy(info.regcontents), type = info.regtype,
      new = (a.nvim_get_current_buf() ~= buf or e.operator == "c") and not reg:match("%u") }
    if a.nvim_get_current_buf() == buf and e.regtype == "V" and e.operator ~= "c"
        and not reg:match("%u") then
      local s = I.current()
      if not s.bad then
        capture.tokens = {}
        local first = f.getpos("'[")[2]
        for i = 1, #e.regcontents do capture.tokens[i] = s.tokens[first + i - 1] end
      end
    end
    if e.operator == "d" or e.operator == "c" then
      if e.regtype == "V" then
        for i = 9, 2, -1 do I.registers[tostring(i)] = I.registers[tostring(i - 1)] end
        I.registers['1'] = capture
      else
        -- Some character motions force register 1 and others use '-'; the
        -- event does not expose use_reg_one. Do not guess numbered lineage.
        for i = 1, 9 do I.registers[tostring(i)] = nil end
      end
    end
    I.registers[reg:lower()] = capture
    local unnamed = f.getreginfo('"').points_to
    if unnamed then I.registers[unnamed] = capture end
    I.registers['"'] = capture
  end) })
  local function observe_put(reg)
    local info, saved = f.getreginfo(reg), I.registers[reg]
    if info.regtype == "V" then
      I.put = { contents = vim.deepcopy(info.regcontents) }
      -- ponytail: registers have no generation counter. Equal-text setreg()
      -- retains observed provenance; cooperating API callers must supply intent.
      if saved and saved.type == info.regtype and vim.deep_equal(saved.contents, info.regcontents) then
        I.put.tokens, I.put.new = saved.tokens, saved.new
      end
    end
  end
  vim.on_key(guarded(function(key)
    if a.nvim_get_current_buf() ~= buf then return end
    pcall(I.current)
    I.put, I.bytes = nil, nil
    if (key == "p" or key == "P") and f.mode(1) == "n" then observe_put(vim.v.register) end
    -- Observer only: no returned string, feedkeys, normal command or mapping.
  end), I.ns)
  a.nvim_create_autocmd("CmdlineLeave", { group = group, callback = guarded(function()
    if a.nvim_get_current_buf() ~= buf or f.getcmdtype() ~= ":" or vim.v.event.abort then return end
    local ok, cmd = pcall(a.nvim_parse_cmd, f.getcmdline(), {})
    if ok and cmd.cmd == "rundo" then
      I.fault = "undo history imported without row identity; :TmuxOilAcceptLive required"
    elseif ok and cmd.cmd == "put" and cmd.nextcmd == "" then
      observe_put(cmd.args[1] or '"')
    end
  end) })
  return I
end

function M.editor_ids() return identity.ids() end

local function annotate(live, metadata)
  if not M.ui_active or not vim.api.nvim_buf_is_valid(M.buf) then return end
  vim.api.nvim_buf_clear_namespace(M.buf, M.ns, 0, -1)
  local widths = { 42, 10, 9 }
  for _, text in pairs(metadata) do
    local fields = status_fields(text)
    if fields then
      for index = 1, 3 do
        local plain = fields[index]:gsub("#%[[^%]]*%]", "")
        widths[index] = math.max(widths[index], vim.fn.strdisplaywidth(plain))
      end
    end
  end
  local ok, ids = pcall(M.editor_ids)
  if not ok then
    vim.api.nvim_buf_set_extmark(M.buf, M.ns, 0, 0, {
      virt_lines = { { { "⚠ " .. tostring(ids), "TmuxOilYellow" } } }, virt_lines_above = true,
    })
    return
  end
  local lines = vim.api.nvim_buf_get_lines(M.buf, 0, -1, false)
  local statuses, status_col = {}, 0
  for row, id in ipairs(ids) do
    local row_width = vim.fn.strdisplaywidth(lines[row])
    if id and M.baseline.by_id[id] then
      local text, group = metadata[id] or "", "Comment"
      local marker, marker_group = "[ ] ", "TmuxOilMeta"
      if live.by_id[id] == nil then
        text, group = "⚠ externally deleted", "TmuxOilYellow"
        marker, marker_group = "[x] ", "TmuxOilRed"
      elseif live.by_id[id] ~= M.baseline.by_id[id] then
        text, group = "⚠ externally renamed to " .. live.by_id[id], "TmuxOilYellow"
        marker, marker_group = "[~] ", "TmuxOilYellow"
      elseif text:find("AGENT DONE", 1, true) then
        marker, marker_group = "[✓] ", "TmuxOilGreen"
      elseif text:find("BUSY", 1, true) or text:find("CACHE CHECKING", 1, true) then
        marker, marker_group = "[~] ", "TmuxOilYellow"
      end
      local prefix = live.tree_prefix_by_id[id] or M.baseline.tree_prefix_by_id[id] or ""
      local label = {}
      if prefix ~= "" then label[#label + 1] = { prefix, "TmuxOilMeta" } end
      label[#label + 1] = { marker, marker_group }
      local parent_option = live.parent_option_by_id[id]
      if parent_option and not live.parent_by_id[id] then
        label[#label + 1] = { "[orphan " .. parent_option .. "] ", "TmuxOilYellow" }
      end
      row_width = vim.fn.strdisplaywidth(annotation_text({ virt_text = label }) .. lines[row])
      vim.api.nvim_buf_set_extmark(M.buf, M.ns, row - 1, 0, {
        virt_text = label, virt_text_pos = "inline", hl_mode = "combine",
        right_gravity = false,
      })
      if text ~= "" then
        local chunks
        if group == "Comment" then
          chunks = styled_chunks(aligned_status(text, widths))
        else
          chunks = { { text:gsub("#%[[^%]]*%]", ""), group } }
        end
        statuses[row] = chunks
      end
    end
    status_col = math.max(status_col, row_width + 2)
  end
  -- Include every current name, even new/status-free rows. EOL padding drifts
  -- when horizontal scrolling passes a short name; a shared column stays aligned.
  for row, chunks in pairs(statuses) do
    vim.api.nvim_buf_set_extmark(M.buf, M.ns, row - 1, 0, {
      virt_text = chunks, virt_text_win_col = status_col, hl_mode = "combine",
    })
  end
  local added = {}
  for _, id in ipairs(live.order) do
    if M.baseline.by_id[id] == nil then
      added[#added + 1] = id .. " " .. live.by_id[id]
    end
  end
  if #added > 0 then
    vim.api.nvim_buf_set_extmark(M.buf, M.ns, 0, 0, {
      virt_lines = { { { "⚠ external sessions added: " .. table.concat(added, ", "),
        "TmuxOilYellow" } } }, virt_lines_above = true,
    })
  end
  M.last_live, M.last_metadata = live, metadata
end

local last_successful_raw
local last_successful_changedtick

function M.poll()
  if not M.ui_active then return end
  if M.poll_process then
    M.poll_pending = true
    M.overlapping_polls = (M.overlapping_polls or 0) + 1
    return
  end
  local generation = M.poll_generation
  local process
  local rank = persistent_order and "#{session_order}" or "#{session_created}"
  process = vim.system(M.argv({
    "list-sessions", "-F", rank
      .. "\t#{session_id}\t#{session_name}\t#{@pi_cache_session}"
      .. "\t#{@pi_subagent_parent_id}",
  }), { text = true }, vim.schedule_wrap(function(result)
    if generation ~= M.poll_generation or process ~= M.poll_process or not M.ui_active then
      return
    end
    M.poll_process = nil
    M.completed_polls = (M.completed_polls or 0) + 1
    if result.code == 0 then
      local output = result.stdout or ""
      local changedtick = vim.b[M.buf].changedtick
      if output ~= last_successful_raw or changedtick ~= last_successful_changedtick then
        local ok, err = pcall(function()
          local live, metadata = parse_live(output)
          annotate(live, metadata)
        end)
        if ok then
          last_successful_raw, last_successful_changedtick = output, changedtick
        else
          M.last_poll_error = tostring(err)
        end
      end
    else
      M.last_poll_error = (result.stderr or "tmux metadata query failed"):gsub("%s+$", "")
    end
    if M.poll_pending then M.poll_pending = false; M.poll() end
  end))
  M.poll_process = process
  M.started_polls = (M.started_polls or 0) + 1
end

function M.stop_polling()
  M.ui_active = false
  M.poll_generation = (M.poll_generation or 0) + 1
  M.poll_pending = false
  if M.timer then
    M.timer:stop()
    if not M.timer:is_closing() then M.timer:close() end
    M.timer = nil
  end
  local process = M.poll_process
  M.poll_process = nil
  if process then
    pcall(function() process:kill(15) end)
    pcall(function() process:wait(1000) end)
  end
end

function M.resume_polling()
  last_successful_raw, last_successful_changedtick = nil, nil
  if not M.buf or not vim.api.nvim_buf_is_valid(M.buf) then return end
  M.ui_active = true
  M.poll_generation = (M.poll_generation or 0) + 1
  M.started_polls, M.completed_polls, M.overlapping_polls = 0, 0, 0
  M.timer = assert(vim.uv.new_timer())
  M.timer:start(0, 250, vim.schedule_wrap(M.poll))
end

function M.cleanup()
  M.stop_polling()
  if M.buf and vim.api.nvim_buf_is_valid(M.buf) and M.ns then
    vim.api.nvim_buf_clear_namespace(M.buf, M.ns, 0, -1)
  end
end

local manifest_help = 'To create a session, add a plain line like: work\n'
  .. 'Edit names to rename; dd/p moves rows. Empty existing names must be filled, not deleted.'

local function editor_manifest(lines)
  local ids, encoded = identity.ids(), {}
  for row, line in ipairs(lines) do
    local id = ids[row]
    if not id then fail("missing row identity") end
    if id ~= "+" or line ~= "" then
      if id ~= "+" and not M.baseline.by_id[id] then
        fail("session " .. id .. " no longer exists in the saved baseline; undo cannot restore killed processes")
      end
      encoded[#encoded + 1] = id .. "\t" .. vim.json.encode(validate_name(line))
    end
  end
  return table.concat(encoded, "\n")
end

function M.editor_intent()
  return M.parse_manifest(editor_manifest(vim.api.nvim_buf_get_lines(M.buf, 0, -1, false)), M.baseline)
end

local function save_error(message)
  local state_home = vim.env.XDG_STATE_HOME
  if not state_home or state_home == "" then state_home = vim.fn.expand("~/.local/state") end
  local dir = vim.env.TMUX_OIL_ERROR_DIR
    or (state_home .. "/tmux-oil/errors")
  local path = string.format("%s/error-%s-%d.log", dir,
    os.date("%Y%m%d-%H%M%S"), vim.uv.hrtime() % 1000000)
  local payload = table.concat({
    "tmux-oil save failure",
    "time: " .. os.date("%Y-%m-%dT%H:%M:%S%z"),
    "socket: " .. socket,
    "",
    message,
    "",
  }, "\n")
  local ok, err = pcall(function()
    vim.fn.mkdir(dir, "p")
    assert(vim.fn.isdirectory(dir) == 1, "could not create " .. dir)
    assert(vim.fn.writefile(vim.split(payload, "\n", { plain = true }), path) == 0,
      "could not write " .. path)
  end)
  if ok then return path end
  return nil, tostring(err)
end

local function intent_with_created_ids(intent, created_ids)
  local result = vim.deepcopy(intent)
  result.existing = vim.deepcopy(intent.existing)
  result.order, result.new = {}, {}
  for _, row in ipairs(intent.order) do
    local id = row.marker == "+" and created_ids[row.name]
    if id then
      result.existing[id] = row.name
      result.order[#result.order + 1] = { marker = id, name = row.name }
    else
      result.order[#result.order + 1] = vim.deepcopy(row)
    end
  end
  for _, name in ipairs(intent.new) do
    if not created_ids[name] then result.new[#result.new + 1] = name end
  end
  return result
end

local function recovery_intent(current, recovery)
  if vim.deep_equal(current, recovery.buffer_intent) then
    local result = vim.deepcopy(recovery.intent)
    result.display_order = vim.deepcopy(current.order)
    return result
  end
  local result = vim.deepcopy(recovery.intent)
  local original = recovery.original_baseline
  local created_ids = recovery.created_ids or {}
  local created_by_name = {}
  for name, id in pairs(created_ids) do created_by_name[name] = id end
  for id in pairs(original.by_id) do
    if current.existing[id] ~= nil then
      if result.existing[id] == nil then
        return nil, "recovery conflict " .. id .. ": already-completed operation was edited back"
      end
      result.existing[id] = current.existing[id]
    else
      result.existing[id] = nil
    end
  end
  local current_new = {}
  for _, name in ipairs(current.new) do current_new[name] = true end
  for name, id in pairs(created_by_name) do
    if not current_new[name] then result.existing[id] = nil end
  end
  local new = {}
  for _, name in ipairs(current.new) do
    if not created_by_name[name] then new[#new + 1] = name end
  end
  result.new = new

  local tokens, represented = {}, {}
  for _, row in ipairs(current.order) do
    local token = row.marker
    if token == "+" then
      local id = created_by_name[row.name]
      token = id or "+" .. row.name
      if id then represented[id] = true end
    elseif result.existing[token] == nil then
      return nil, "recovery conflict " .. token .. ": pending target is no longer acknowledged"
    else
      represented[token] = true
    end
    tokens[#tokens + 1] = token
  end
  local extras, source = {}, {}
  for _, row in ipairs(result.order) do
    local token = row.marker == "+" and (created_by_name[row.name] or "+" .. row.name)
      or row.marker
    source[#source + 1] = token
    if result.existing[row.marker] and not represented[row.marker] then extras[row.marker] = true end
  end
  insert_extras(tokens, source, extras)
  result.order = {}
  for _, token in ipairs(tokens) do
    local id, name = token:match("^(%$%d+)$")
    if id then
      name = result.existing[id]
      result.order[#result.order + 1] = { marker = id, name = name }
    else
      name = token:sub(1, 1) == "+" and token:sub(2) or token
      result.order[#result.order + 1] = { marker = "+", name = name }
    end
  end
  result.display_order = vim.deepcopy(current.order)
  return result
end

local function failure_counts(report)
  if not report then return 0, 0 end
  return report.completed or #(report.succeeded or {}),
    report.pending or #(report.not_run or {})
end

local function save_failure(message)
  local report = M.last_apply_report
  local detail = tostring(message)
  if report and report.before and report.current then
    report.differences = report.differences
      or M.describe_difference(report.acknowledged or report.before, report.current)
    detail = detail .. "\nacknowledged/live metadata differences: " .. report.differences
    if report.acknowledged and not vim.deep_equal(report.before, report.acknowledged) then
      detail = detail .. "\noriginal/acknowledged metadata differences: "
        .. M.describe_difference(report.before, report.acknowledged)
    end
  end
  local path, save_failure_error = save_error(detail)
  local completed, pending = failure_counts(report)
  local first = detail:match("^[^\n]+") or detail
  if report and report.differences then
    first = first .. "; " .. (report.differences:match("^[^;]+") or report.differences)
  end
  local summary = string.format("%s (completed %d, pending %d)", first, completed, pending)
  if path then
    M.last_error_path = path
    summary = summary .. ". Diagnostic saved to: " .. path
  else
    summary = summary .. ". Diagnostic could not be saved: " .. tostring(save_failure_error)
  end
  M.last_error = summary
  if not M.ui_active then pcall(M.resume_polling) end
  vim.notify(summary, vim.log.levels.WARN, { title = "tmux-oil save failed" })
  return false, summary
end

function M.save()
  M.last_apply_report = nil
  local parsed_intent, apply_baseline, apply_intent, attempt, lines
  local ok, result = pcall(function()
    -- Reject invalid edits without blanking annotations or interrupting polling.
    local valid, validation_error = pcall(M.editor_intent)
    if not valid then
      fail(tostring(validation_error):gsub("^tmux%-oil: ", "") .. "\n" .. manifest_help)
    end
    M.cleanup()
    if M.test_before_final_reread then M.test_before_final_reread() end
    lines = vim.api.nvim_buf_get_lines(M.buf, 0, -1, false)
    local parsed, intent = pcall(function()
      return M.parse_manifest(editor_manifest(lines), M.baseline)
    end)
    if not parsed then
      fail(tostring(intent):gsub("^tmux%-oil: ", "") .. "\n" .. manifest_help)
    end
    parsed_intent = intent
    apply_baseline, apply_intent = M.baseline, intent
    if M.pending_recovery then
      local recovered, recovery_error = recovery_intent(intent, M.pending_recovery)
      if not recovered then fail(recovery_error) end
      apply_baseline, apply_intent = M.pending_recovery.baseline, recovered
    end
    local live = M.snapshot()
    local reconciled, conflict = M.reconcile(apply_baseline, apply_intent, live)
    if not reconciled then
      M.last_apply_report = {
        before = apply_baseline, current = live, acknowledged = copy_state(live),
        operations = {}, succeeded = {}, not_run = {}, attempted = {},
        completed = 0, pending = 0, error = conflict,
      }
      fail(conflict)
    end
    apply_intent = reconciled
    attempt = { baseline = live, intent = reconciled, buffer_intent = intent }
    return M.apply(live, reconciled)
  end)
  if not ok then
    local report = M.last_apply_report
    if report and #(report.succeeded or {}) > 0 and attempt then
      M.pending_recovery = {
        baseline = report.acknowledged,
        intent = intent_with_created_ids(attempt.intent, report.created_ids or {}),
        buffer_intent = parsed_intent,
        original_baseline = M.baseline,
        created_ids = vim.deepcopy(report.created_ids or {}),
      }
    end
    return save_failure(result)
  end
  M.recovered_creates = M.pending_recovery and M.pending_recovery.created_ids
  M.pending_recovery = nil
  if result.warning then
    vim.notify(result.warning, vim.log.levels.WARN, { title = "tmux-oil ordering skipped" })
  end
  -- Creation acknowledgement binds the private token in every undo branch.
  -- Never resurrect a killed ID by matching its old name to a live session.
  local state = identity.checked()
  for row, token in ipairs(state.tokens) do
    if not identity.bindings[token] then
      identity.bindings[token] = (result.created_ids or {})[state.lines[row]]
        or (M.recovered_creates or {})[state.lines[row]]
    end
  end
  vim.bo[M.buf].modified = false
  M.start()
  return true, result
end

local function intent_matches_state(intent, state)
  local rows = intent.display_order or intent.order
  if #intent.new > 0 or #rows ~= #state.order then return false end
  for index, row in ipairs(rows) do
    if row.marker ~= state.order[index] or row.name ~= state.by_id[row.marker] then
      return false
    end
  end
  return true
end

function M.refresh()
  M.cleanup()
  local ok, result = pcall(function()
    local lines = vim.api.nvim_buf_get_lines(M.buf, 0, -1, false)
    local parsed, intent = pcall(function()
      return M.parse_manifest(editor_manifest(lines), M.baseline)
    end)
    if not parsed then fail(tostring(intent):gsub("^tmux%-oil: ", "")) end
    local base, refresh_intent = M.baseline, intent
    if M.pending_recovery then
      local recovered, recovery_error = recovery_intent(intent, M.pending_recovery)
      if not recovered then fail(recovery_error) end
      base, refresh_intent = M.pending_recovery.baseline, recovered
    end
    local live = M.snapshot()
    local reconciled, conflict = M.reconcile(base, refresh_intent, live)
    if not reconciled then fail(conflict .. "\nedit the conflicting row or use :TmuxOilAcceptLive") end
    identity.replace(reconciled.display_order or reconciled.order)
    M.baseline = live
    vim.bo[M.buf].modified = not intent_matches_state(reconciled, live)
    M.pending_recovery = nil
  end)
  if not ok then
    pcall(M.resume_polling)
    vim.notify(tostring(result), vim.log.levels.WARN, { title = "tmux-oil refresh failed" })
    return false, tostring(result)
  end
  M.resume_polling()
  vim.notify("tmux-oil buffer refreshed; local edits remain pending", vim.log.levels.INFO,
    { title = "tmux-oil" })
  return true
end

function M.accept_live()
  local ok, result = pcall(function()
    M.pending_recovery = nil
    M.start()
    vim.notify("tmux-oil discarded local edits and accepted live sessions",
      vim.log.levels.INFO, { title = "tmux-oil" })
  end)
  if not ok then
    pcall(M.resume_polling)
    vim.notify(tostring(result), vim.log.levels.ERROR, { title = "tmux-oil accept live failed" })
    return false, tostring(result)
  end
  return true
end

function M.jump()
  local id = identity.ids()[vim.api.nvim_win_get_cursor(0)[1]]
  if not id or not M.baseline.by_id[id] then fail("place the cursor on an existing session to jump") end
  if vim.bo[M.buf].modified then
    fail("buffer has unsaved changes - :wq to apply or abandon before jumping")
  end
  M.tmux({ "switch-client", "-t", id })
  vim.cmd("q!")
end

function M.start()
  M.cleanup()
  M.buf = vim.api.nvim_get_current_buf()
  M.baseline = M.snapshot()
  M.ns = M.ns or vim.api.nvim_create_namespace("tmux-oil-live")

  M.poll_generation = (M.poll_generation or 0) + 1
  M.started_polls, M.completed_polls, M.overlapping_polls = 0, 0, 0
  local rows = {}
  for _, id in ipairs(M.baseline.order) do rows[#rows + 1] = { marker = id, name = M.baseline.by_id[id] } end
  if identity and identity.buf == M.buf then
    identity.replace(rows)
  else
    local levels = vim.bo[M.buf].undolevels
    vim.bo[M.buf].undolevels = -1
    identity = new_identity(M.buf, rows)
    vim.bo[M.buf].undolevels = levels
  end
  vim.api.nvim_buf_set_name(M.buf, "tmux-oil://sessions")
  vim.bo[M.buf].buftype = "acwrite"
  vim.bo[M.buf].filetype = "tmux-oil"
  vim.bo[M.buf].swapfile = false
  vim.bo[M.buf].undofile = false
  vim.bo[M.buf].modified = false
  vim.wo.wrap = false
  vim.wo.cursorline = true
  vim.wo.cursorlineopt = "line"
  vim.opt.laststatus = 0
  vim.api.nvim_set_hl(0, "Normal", {
    bg = "#000000", fg = "#e4e4e4", ctermbg = 0, ctermfg = 7,
  })
  vim.api.nvim_set_hl(0, "NormalFloat", {
    bg = "#0a0a0a", fg = "#e4e4e4", ctermbg = 0, ctermfg = 7,
  })
  vim.api.nvim_set_hl(0, "CursorLine", { bg = "#4f5258", ctermbg = 8 })
  vim.api.nvim_set_hl(0, "TmuxOilMeta", { fg = "#e4e4e4", ctermfg = 7 })
  vim.api.nvim_set_hl(0, "TmuxOilGreen", { fg = "#5fff87", ctermfg = 10 })
  vim.api.nvim_set_hl(0, "TmuxOilYellow", { fg = "#ffff00", ctermfg = 11 })
  vim.api.nvim_set_hl(0, "TmuxOilRed", { fg = "#ff5f5f", ctermfg = 9 })
  local target_row, current = 1, current_session_id()
  for row, id in ipairs(M.baseline.order) do
    if id == current then target_row = row; break end
  end
  vim.api.nvim_win_set_cursor(0, { target_row, 0 })
  local group = vim.api.nvim_create_augroup("tmux_oil_private", { clear = true })
  vim.api.nvim_create_autocmd("BufWriteCmd", {
    group = group, buffer = M.buf,
    callback = function()
      local ok, err = pcall(M.save)
      if not ok then save_failure(err) end
    end,
  })
  vim.api.nvim_create_autocmd({ "TextChanged", "TextChangedI", "TextChangedP" }, {
    group = group, buffer = M.buf,
    callback = function()
      if M.last_live then annotate(M.last_live, M.last_metadata) end
    end,
  })
  vim.api.nvim_create_autocmd({ "BufWipeout", "VimLeavePre" }, {
    group = group, callback = M.cleanup,
  })
  vim.keymap.set("n", "<CR>", M.jump, { buffer = M.buf, silent = true })
  vim.api.nvim_buf_create_user_command(M.buf, "TmuxOilRefresh", M.refresh, { force = true })
  vim.api.nvim_buf_create_user_command(M.buf, "TmuxOilAcceptLive", M.accept_live, { force = true })
  M.resume_polling()
end

if vim.env.TMUX_OIL_TEST_LUA then
  local ok, err = pcall(dofile, vim.env.TMUX_OIL_TEST_LUA)
  if not ok then
    io.stderr:write(err .. "\n")
    vim.cmd("cquit 1")
  elseif not vim.env.TMUX_OIL_TEST_STAY then
    vim.cmd("qa!")
  end
  return
end

M.start()
# __TMUX_OIL_LUA_END__
TMUX_OIL_LUA

if [ -n "${TMUX_OIL_TEST_LUA-}" ]; then
  exec "$TMUX_OIL_NVIM_BIN" --clean -u NONE \
    --cmd "lua assert(load(vim.env.TMUX_OIL_INIT, '@tmux-oil'))()" --headless
else
  exec "$TMUX_OIL_NVIM_BIN" --clean -u NONE \
    --cmd "lua assert(load(vim.env.TMUX_OIL_INIT, '@tmux-oil'))()"
fi
