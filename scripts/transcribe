#!/usr/bin/env bash
set -euo pipefail

PROJECT="$HOME/projects/canary-coreml-transcribe"
SUPERVISOR="$PROJECT/canary_qwen_transcribe/transcribe_supervisor.py"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export UV_OFFLINE=1

if [[ ! -d "$PROJECT" ]]; then
  echo "transcribe: project missing: $PROJECT" >&2
  exit 1
fi
if [[ ! -f "$SUPERVISOR" ]]; then
  echo "transcribe: supervisor missing: $SUPERVISOR" >&2
  exit 1
fi

tmp=0
args=()
for a in "$@"; do
  case "$a" in
    --tmp) tmp=1 ;;
    *) args+=("$a") ;;
  esac
done
if ((${#args[@]})); then
  set -- "${args[@]}"
else
  set --
fi

# First existing arg is the audio. If stdin is piped, wait for EOF and use the
# first line that is an existing file; this makes `record-mic | transcribe --tmp`
# wait until recording stops before transcribing.
src=""
for a in "$@"; do
  if [[ -f "$a" ]]; then src="$a"; break; fi
done

if [[ -z "$src" && ! -t 0 ]]; then
  trap '' INT
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$src" && -n "$line" ]]; then
      src="$line"
    fi
  done
  trap - INT
  if [[ -n "$src" ]]; then
    set -- "$@" "$src"
  fi
fi

archive=""
ref_audio=""
if [[ "$tmp" -eq 0 && -n "$src" ]]; then
  fname="$(basename -- "$src")"
  case "$fname" in
    *.*) base="${fname%.*}"; ext=".${fname##*.}" ;;
    *)   base="$fname";      ext="" ;;
  esac
  stamp="$(TZ='America/Los_Angeles' date '+%Y-%m-%d %H-%M-%S')"
  day="${stamp% *}"; clock="${stamp#* }"
  text_dir="$HOME/transcriptions/${day}_text"
  audio_dir="$HOME/transcriptions/${day}_ref-audio"
  archive="$text_dir/${base}_${clock}.txt"

  is_video=0
  if command -v ffprobe >/dev/null 2>&1; then
    if video_stream="$(ffprobe -v error -select_streams V:0 \
        -show_entries stream=index -of csv=p=0 "$src" 2>/dev/null)"; then
      [[ -n "$video_stream" ]] && is_video=1
    else
      echo "transcribe: cannot inspect media streams: $src" >&2
      exit 1
    fi
  else
    # /usr/bin/env bash is Bash 3.2 here, so do not use ${ext,,}.
    ext_lower="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
    case "$ext_lower" in
      .mov|.mp4|.m4v|.mkv|.avi|.webm|.mpeg|.mpg|.mts|.m2ts|.ts|.wmv|.flv|.3gp)
        echo "transcribe: ffprobe is required to archive video as Opus" >&2
        exit 127
        ;;
    esac
  fi

  if (( is_video )); then
    command -v ffmpeg >/dev/null 2>&1 || {
      echo "transcribe: ffmpeg with libopus is required to archive video" >&2
      exit 127
    }
    ref_audio="$audio_dir/${base}_${clock}.opus"
  else
    ref_audio="$audio_dir/${base}_${clock}${ext}"
  fi

  mkdir -p "$text_dir" "$audio_dir"
  trap 'rm -f -- "${archive:-}" "${ref_audio:-}"; exit 130' INT TERM
  set +e
  if (( is_video )); then
    ffmpeg -nostdin -hide_banner -loglevel error -y -i "$src" \
      -vn -ac 1 -ar 16000 -c:a libopus -b:a 64k "$ref_audio"
  else
    cp -p -- "$src" "$ref_audio" 2>/dev/null
  fi
  archive_status=$?
  set -e
  trap - INT TERM
  # Keep the old best-effort archive behavior for normal cp errors, but make
  # every video-conversion failure fatal and preserve signal cleanup.
  if (( (is_video && archive_status != 0) || archive_status >= 128 )); then
    rm -f -- "$archive" "$ref_audio"
    exit "$archive_status"
  fi
fi

cmd=(uv run --project "$PROJECT" --offline --frozen python -m canary_qwen_transcribe.transcribe_compat "$@")

if [[ -n "$archive" ]]; then
  # The Python supervisor tees stdout to the archive and runs uv/python in a
  # separate process group. Ctrl-C hits the supervisor, which can terminate
  # native CoreML work immediately instead of waiting for KeyboardInterrupt.
  exec /usr/bin/python3 "$SUPERVISOR" \
    --archive "$archive" \
    --ref-audio "$ref_audio" \
    -- "${cmd[@]}"
else
  exec /usr/bin/python3 "$SUPERVISOR" -- "${cmd[@]}"
fi
